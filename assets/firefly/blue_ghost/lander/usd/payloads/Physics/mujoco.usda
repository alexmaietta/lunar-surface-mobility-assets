#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "blue_ghost"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "blue_ghost"
{
    over "Physics"
    {
        over "leg_0_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_1_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_2_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_3_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "xband_azimuth" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "xband_azimuth_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -20, -2, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 10
            uniform double mjc:forceRange:min = -10
            uniform double[] mjc:gainPrm = [20, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </blue_ghost/Physics/xband_azimuth>
        }

        over "xband_elevation" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "xband_elevation_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -20, -2, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 10
            uniform double mjc:forceRange:min = -10
            uniform double[] mjc:gainPrm = [20, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </blue_ghost/Physics/xband_elevation>
        }
    }
}

