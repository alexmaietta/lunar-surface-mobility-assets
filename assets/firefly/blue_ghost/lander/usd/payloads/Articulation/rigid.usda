#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "blue_ghost"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "blue_ghost"
{
    over "Geometry"
    {
        over "body"
        {
            over "leg_0_piston" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "leg_1_piston" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "leg_2_piston" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "leg_3_piston" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "xband_azimuth" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                over "xband_elevation" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "leg_0_piston" (
            active = false
        )
        {
        }

        over "leg_0_piston_actuator" (
            active = false
        )
        {
        }

        over "leg_1_piston" (
            active = false
        )
        {
        }

        over "leg_1_piston_actuator" (
            active = false
        )
        {
        }

        over "leg_2_piston" (
            active = false
        )
        {
        }

        over "leg_2_piston_actuator" (
            active = false
        )
        {
        }

        over "leg_3_piston" (
            active = false
        )
        {
        }

        over "leg_3_piston_actuator" (
            active = false
        )
        {
        }

        over "xband_azimuth" (
            active = false
        )
        {
        }

        over "xband_azimuth_actuator" (
            active = false
        )
        {
        }

        over "xband_elevation" (
            active = false
        )
        {
        }

        over "xband_elevation_actuator" (
            active = false
        )
        {
        }
    }
}

