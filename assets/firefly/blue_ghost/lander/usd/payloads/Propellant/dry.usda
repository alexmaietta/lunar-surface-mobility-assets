#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "blue_ghost"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "blue_ghost"
{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 1.18)
            float3 physics:diagonalInertia = (258.34082, 258.34082, 234.5)
            float physics:mass = 469
            custom string propellant:source = "Firefly: 469 kg dry with payloads"
        }
    }
}

