#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "blue_ghost"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "blue_ghost"
{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 1.25)
            float3 physics:diagonalInertia = (835.6142, 835.6142, 758.5)
            float physics:mass = 1517
            custom string propellant:source = "Firefly: 1,517 kg fuelled"
        }
    }
}

