    def Xform "body_hull_col" (
        prepend references = @./geometries.usd@</Geometries/body_hull_col>
    )
    {
        over "body_hull_col" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonCollisionAPI", "NewtonMeshCollisionAPI", "PhysxConvexHullCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Instances/body_hull_col/PhysicsMaterials/structure> (
                bindMaterialAs = "weakerThanDescendants"
            )
            uniform int newton:maxHullVertices = 255
            uniform token physics:approximation = "convexHull"
            int physxConvexHullCollision:hullVertexLimit = 255
            uniform token purpose = "guide"
        }

        def Scope "PhysicsMaterials"
        {
            def Material "structure" (
                prepend references = @./physics_materials.usda@</PhysicsMaterials/structure>
            )
            {
            }
        }
    }

