#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "peregrine"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "peregrine"
{
    over "Physics"
    {
        over "leg_0_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_1_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_2_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_3_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }
    }
}

