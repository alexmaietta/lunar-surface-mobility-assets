#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "peregrine"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "peregrine"
{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 1.2)
            float3 physics:diagonalInertia = (561.3125, 561.3125, 641.5)
            float physics:mass = 1283
            custom string propellant:source = "Astrobotic: 1,283 kg fuelled (PM1)"
        }
    }
}

