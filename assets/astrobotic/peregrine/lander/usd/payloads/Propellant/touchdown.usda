#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "peregrine"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "peregrine"
{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 1.25)
            float3 physics:diagonalInertia = (253.75, 253.75, 290)
            float physics:mass = 580
            custom string propellant:source = "estimate: ~413 kg dry bus + 90 kg payload + ~75 kg residuals"
        }
    }
}

