{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 3.4)
            float3 physics:diagonalInertia = (14039.968, 14039.968, 9717.435)
            float physics:mass = 4407
            custom string propellant:source = "ascent dry ~2,130 kg + descent dry ~2,770 kg"
        }
    }
}

