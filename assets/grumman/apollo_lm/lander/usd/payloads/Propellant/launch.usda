#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "apollo_lm"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "apollo_lm"
{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 2.99)
            float3 physics:diagonalInertia = (50677.05, 50677.05, 35074.934)
            float physics:mass = 15907
            custom string propellant:source = "J-mission LM launch mass ~16,400 kg (NASA News Reference)"
        }
    }
}

