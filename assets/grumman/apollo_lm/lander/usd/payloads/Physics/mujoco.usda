#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "apollo_lm"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "apollo_lm"
{
    over "Physics"
    {
        over "dps_gimbal_x" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "dps_gimbal_x_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -40000, -800, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 8000
            uniform double mjc:forceRange:min = -8000
            uniform double[] mjc:gainPrm = [40000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </apollo_lm/Physics/dps_gimbal_x>
        }

        over "dps" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "dps_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -40000, -800, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 8000
            uniform double mjc:forceRange:min = -8000
            uniform double[] mjc:gainPrm = [40000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </apollo_lm/Physics/dps>
        }

        over "leg_0_primary_stage1" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_0_primary_inner" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_0_secondary_a_compression" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_0_secondary_a_tension1" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_0_secondary_a_outer" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_0_secondary_b_compression" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_0_secondary_b_tension1" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
