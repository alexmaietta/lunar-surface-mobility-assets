#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "apollo_lm"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "apollo_lm"
{
    over "Geometry"
    {
        over "body" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysxArticulationAPI"]
        )
        {
            bool physxArticulation:enabledSelfCollisions = 0
            int physxArticulation:solverPositionIterationCount = 32
            int physxArticulation:solverVelocityIterationCount = 1
        }
    }

    over "Physics"
    {
        over "dps_gimbal_x" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180
        }

        over "dps" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180
        }

        over "leg_0_primary_stage1" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 2
        }

        over "leg_0_primary_inner" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 2
        }

        over "leg_0_secondary_a_compression" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 2
        }

        over "leg_0_secondary_a_tension1" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
