        </apollo_lm/Geometry/body/leg_0_secondary_a_inner/leg_0_secondary_a_compression/leg_0_secondary_a_tension1>,
        </apollo_lm/Geometry/body/leg_0_secondary_a_inner/leg_0_secondary_a_compression/leg_0_secondary_a_tension1/leg_0_secondary_a_outer>,
