        </apollo_lm/Geometry/body/leg_3_secondary_b_inner/leg_3_secondary_b_compression/leg_3_secondary_b_tension1/leg_3_secondary_b_outer>,
        </apollo_lm/Geometry/body/rr_shaft>,
        </apollo_lm/Geometry/body/rr_shaft/rr_trunnion>,
        </apollo_lm/Geometry/body/rr_shaft/rr_trunnion/rr_boresight>,
        </apollo_lm/Geometry/body/sband_azimuth>,
        </apollo_lm/Geometry/body/sband_azimuth/sband_elevation>,
        </apollo_lm/Geometry/body/sband_azimuth/sband_elevation/sband_boresight>,
    ]
    token isaac:robotType = "Aerial"
    string isaac:source = "lunar-surface-mobility-assets pipeline"
    string isaac:version = "0.1.0"

    over "Geometry"
    {
        over "body" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "dps_gimbal_x" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "dps" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "dps_exit" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "TRW LM Descent Propulsion System (J-mission, 10 in nozzle extension): 9,870 lbf full thrust, ~10-65% throttle, +/-6 deg gimbal (Grumman/NASA News Reference)."
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "leg_0_primary" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "leg_0_primary_stage1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "leg_0_primary_inner" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "leg_0_footpad" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "leg_0_foot_contact" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                                string isaac:Description = "Footpad contact point (touchdown sensing)"
                                uniform token isaac:forwardAxis = "Z"
                            }
                        }

                        over "leg_0_touchdown_sensor" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Primary strut stroke: 4,500 lb stage to 12 in, 9,500 lb stage to 32 in (NASA TN D-6850)"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "leg_0_secondary_a_inner" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "leg_0_secondary_a_compression" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "leg_0_secondary_a_tension1" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "leg_0_secondary_a_outer" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

