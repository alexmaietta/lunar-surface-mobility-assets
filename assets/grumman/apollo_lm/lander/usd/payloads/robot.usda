        </apollo_lm/Geometry/body/leg_1_secondary_b_inner/leg_1_secondary_b_compression/leg_1_secondary_b_tension1>,
        </apollo_lm/Geometry/body/leg_1_secondary_b_inner/leg_1_secondary_b_compression/leg_1_secondary_b_tension1/leg_1_secondary_b_outer>,
        </apollo_lm/Geometry/body/leg_2_primary>,
        </apollo_lm/Geometry/body/leg_2_primary/leg_2_primary_stage1>,
        </apollo_lm/Geometry/body/leg_2_primary/leg_2_primary_stage1/leg_2_primary_inner>,
        </apollo_lm/Geometry/body/leg_2_primary/leg_2_primary_stage1/leg_2_primary_inner/leg_2_touchdown_sensor>,
        </apollo_lm/Geometry/body/leg_2_primary/leg_2_primary_stage1/leg_2_primary_inner/leg_2_footpad>,
        </apollo_lm/Geometry/body/leg_2_primary/leg_2_primary_stage1/leg_2_primary_inner/leg_2_footpad/leg_2_foot_contact>,
        </apollo_lm/Geometry/body/leg_2_secondary_a_inner>,
