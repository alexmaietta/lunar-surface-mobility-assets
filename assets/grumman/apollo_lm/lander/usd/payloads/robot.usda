        </apollo_lm/Physics/leg_3_footpad>,
        </apollo_lm/Physics/leg_3_secondary_a_inner>,
        </apollo_lm/Physics/leg_3_secondary_a_compression>,
        </apollo_lm/Physics/leg_3_secondary_a_tension1>,
        </apollo_lm/Physics/leg_3_secondary_a_outer>,
        </apollo_lm/Physics/leg_3_secondary_b_inner>,
        </apollo_lm/Physics/leg_3_secondary_b_compression>,
