        </apollo_lm/Geometry/body/leg_1_primary/leg_1_primary_stage1/leg_1_primary_inner>,
        </apollo_lm/Geometry/body/leg_1_primary/leg_1_primary_stage1/leg_1_primary_inner/leg_1_touchdown_sensor>,
        </apollo_lm/Geometry/body/leg_1_primary/leg_1_primary_stage1/leg_1_primary_inner/leg_1_footpad>,
