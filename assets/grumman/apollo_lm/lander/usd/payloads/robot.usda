#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "apollo_lm"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "apollo_lm" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "Apollo Lunar Module"
    token isaac:license = "Other"
    string isaac:namespace = "apollo_lm"
    prepend rel isaac:physics:robotJoints = [
        </apollo_lm/Physics/dps_gimbal_x>,
        </apollo_lm/Physics/dps>,
        </apollo_lm/Physics/leg_0_primary>,
        </apollo_lm/Physics/leg_0_primary_stage1>,
        </apollo_lm/Physics/leg_0_primary_inner>,
        </apollo_lm/Physics/leg_0_footpad>,
        </apollo_lm/Physics/leg_0_secondary_a_inner>,
        </apollo_lm/Physics/leg_0_secondary_a_compression>,
        </apollo_lm/Physics/leg_0_secondary_a_tension1>,
        </apollo_lm/Physics/leg_0_secondary_a_outer>,
        </apollo_lm/Physics/leg_0_secondary_b_inner>,
        </apollo_lm/Physics/leg_0_secondary_b_compression>,
        </apollo_lm/Physics/leg_0_secondary_b_tension1>,
