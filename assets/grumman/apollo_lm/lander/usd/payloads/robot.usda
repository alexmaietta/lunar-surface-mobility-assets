        </apollo_lm/Geometry/body/docking_port>,
        </apollo_lm/Geometry/body/forward_hatch>,
        </apollo_lm/Geometry/body/imu>,
        </apollo_lm/Geometry/body/lift_point_0>,
        </apollo_lm/Geometry/body/lift_point_1>,
        </apollo_lm/Geometry/body/lift_point_2>,
        </apollo_lm/Geometry/body/lift_point_3>,
        </apollo_lm/Geometry/body/dps_gimbal_x>,
        </apollo_lm/Geometry/body/dps_gimbal_x/dps>,
        </apollo_lm/Geometry/body/dps_gimbal_x/dps/dps_exit>,
        </apollo_lm/Geometry/body/leg_0_primary>,
        </apollo_lm/Geometry/body/leg_0_primary/leg_0_primary_stage1>,
