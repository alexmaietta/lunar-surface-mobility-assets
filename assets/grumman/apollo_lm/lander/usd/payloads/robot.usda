            over "rr_shaft" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rr_trunnion" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "rr_boresight" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "Rendezvous radar boresight (+Z), shaft/trunnion mount"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "sband_azimuth" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "sband_elevation" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "sband_boresight" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "Steerable S-band antenna boresight (+Z), 26 in dish"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "dps_gimbal_center" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "DPS gimbal pivot"
                uniform token isaac:forwardAxis = "Z"
            }

            over "aps_exit" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Bell LM Ascent Propulsion System: 3,500 lbf fixed, not throttleable or gimballed (NASA News Reference). Exit plane height inferred."
                uniform token isaac:forwardAxis = "Z"
            }

            over "rcs_0_0" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Marquardt R-4D, 100 lbf; 16 thrusters in four quads (Grumman/NASA). Plume deflectors not modelled."
                uniform token isaac:forwardAxis = "Z"
            }

            over "rcs_0_1" (
