        </apollo_lm/Physics/leg_1_secondary_b_tension1>,
        </apollo_lm/Physics/leg_1_secondary_b_outer>,
        </apollo_lm/Physics/leg_2_primary>,
        </apollo_lm/Physics/leg_2_primary_stage1>,
        </apollo_lm/Physics/leg_2_primary_inner>,
        </apollo_lm/Physics/leg_2_footpad>,
        </apollo_lm/Physics/leg_2_secondary_a_inner>,
        </apollo_lm/Physics/leg_2_secondary_a_compression>,
        </apollo_lm/Physics/leg_2_secondary_a_tension1>,
        </apollo_lm/Physics/leg_2_secondary_a_outer>,
