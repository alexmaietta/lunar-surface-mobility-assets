#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "moon_racer"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "moon_racer"
{
    over "Physics"
    {
        over "arm_yaw" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "arm_yaw_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -2400, -240, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 160
            uniform double mjc:forceRange:min = -160
            uniform double[] mjc:gainPrm = [2400, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </moon_racer/Physics/arm_yaw>
        }

        over "arm_shoulder" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "arm_shoulder_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -2400, -240, 0, 0, 0, 0, 0, 0, 0]
