            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 48
            uniform double mjc:forceRange:min = -48
            uniform double[] mjc:gainPrm = [720, 0, 0, 0, 0, 0, 0, 0, 0, 0]
