            uniform double[] mjc:biasPrm = [0, -1440, -144, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 96
            uniform double mjc:forceRange:min = -96
            uniform double[] mjc:gainPrm = [1440, 0, 0, 0, 0, 0, 0, 0, 0, 0]
