                uniform token isaac:forwardAxis = "Z"
            }

            over "deck_light" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "rear_deck" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Rear payload deck (400 kg)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "tow_hitch" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Trailer hitch (800 kg trailer)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "tower_hazcam_l" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Tower hazard camera pod"
                uniform token isaac:forwardAxis = "Z"
            }

            over "tower_hazcam_r" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Tower hazard camera pod"
                uniform token isaac:forwardAxis = "Z"
            }

            over "tower_stereo" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Tower stereo navigation camera pod"
                uniform token isaac:forwardAxis = "Z"
            }

            over "beacon_l" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Orange beacon"
                uniform token isaac:forwardAxis = "Z"
            }

            over "beacon_r" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Orange beacon"
                uniform token isaac:forwardAxis = "Z"
            }

            over "vehicle_origin" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Ground point under the chassis centre at nominal ride height"
                uniform token isaac:forwardAxis = "Z"
            }

            over "imu" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IMU / navigation reference (estimated)"
                uniform token isaac:forwardAxis = "Z"
            }
        }
    }

    over "Physics"
