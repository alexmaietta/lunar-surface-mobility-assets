#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "nova_c"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "nova_c"
{
    over "Geometry"
    {
        over "body" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0, 0, 2.45)
