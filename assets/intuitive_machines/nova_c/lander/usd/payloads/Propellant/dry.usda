#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "nova_c"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "nova_c"
{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 2.5)
            float3 physics:diagonalInertia = (903.5208, 903.5208, 313.875)
            float physics:mass = 775
            custom string propellant:source = "675 kg dry bus (IM) + ~100 kg payload"
        }
    }
}

