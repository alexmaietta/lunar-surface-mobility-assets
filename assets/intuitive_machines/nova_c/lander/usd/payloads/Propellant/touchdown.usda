#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "nova_c"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "nova_c"
{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 2.45)
            float3 physics:diagonalInertia = (1002.61664, 1002.61664, 348.3)
            float physics:mass = 860
            custom string propellant:source = "estimate: 675 kg dry + ~100 kg payload + ~85 kg residuals"
        }
    }
}

