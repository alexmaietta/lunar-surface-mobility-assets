#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "nova_c"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "nova_c" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "Intuitive Machines Nova-C"
    token isaac:license = "Other"
    string isaac:namespace = "nova_c"
    prepend rel isaac:physics:robotJoints = [
        </nova_c/Physics/leg_0_piston>,
        </nova_c/Physics/leg_1_piston>,
        </nova_c/Physics/leg_2_piston>,
        </nova_c/Physics/leg_3_piston>,
        </nova_c/Physics/leg_4_piston>,
        </nova_c/Physics/leg_5_piston>,
        </nova_c/Physics/vr900_gimbal_x>,
        </nova_c/Physics/vr900>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </nova_c/Geometry/body>,
        </nova_c/Geometry/body/top_array_normal>,
        </nova_c/Geometry/body/vr900_gimbal_center>,
        </nova_c/Geometry/body/rcs_0_0>,
        </nova_c/Geometry/body/rcs_0_1>,
        </nova_c/Geometry/body/rcs_0_2>,
        </nova_c/Geometry/body/rcs_1_0>,
        </nova_c/Geometry/body/rcs_1_1>,
        </nova_c/Geometry/body/rcs_1_2>,
        </nova_c/Geometry/body/rcs_2_0>,
        </nova_c/Geometry/body/rcs_2_1>,
        </nova_c/Geometry/body/rcs_2_2>,
        </nova_c/Geometry/body/rcs_3_0>,
        </nova_c/Geometry/body/rcs_3_1>,
        </nova_c/Geometry/body/rcs_3_2>,
        </nova_c/Geometry/body/rcs_4_0>,
        </nova_c/Geometry/body/rcs_4_1>,
        </nova_c/Geometry/body/rcs_4_2>,
        </nova_c/Geometry/body/rcs_5_0>,
        </nova_c/Geometry/body/rcs_5_1>,
        </nova_c/Geometry/body/rcs_5_2>,
        </nova_c/Geometry/body/side_array_0_normal>,
        </nova_c/Geometry/body/side_array_1_normal>,
        </nova_c/Geometry/body/hga_boresight>,
        </nova_c/Geometry/body/lga_0>,
        </nova_c/Geometry/body/lga_1>,
        </nova_c/Geometry/body/lga_2>,
        </nova_c/Geometry/body/lga_3>,
        </nova_c/Geometry/body/ndl>,
        </nova_c/Geometry/body/lra>,
