        </nova_c/Geometry/body/deck_center>,
        </nova_c/Geometry/body/imu>,
        </nova_c/Geometry/body/lift_point_0>,
        </nova_c/Geometry/body/lift_point_1>,
        </nova_c/Geometry/body/lift_point_2>,
        </nova_c/Geometry/body/lift_point_3>,
        </nova_c/Geometry/body/lift_point_4>,
        </nova_c/Geometry/body/lift_point_5>,
        </nova_c/Geometry/body/leg_0_piston>,
        </nova_c/Geometry/body/leg_0_piston/leg_0_foot_contact>,
        </nova_c/Geometry/body/leg_0_piston/leg_0_touchdown_sensor>,
        </nova_c/Geometry/body/leg_1_piston>,
        </nova_c/Geometry/body/leg_1_piston/leg_1_foot_contact>,
        </nova_c/Geometry/body/leg_1_piston/leg_1_touchdown_sensor>,
        </nova_c/Geometry/body/leg_2_piston>,
        </nova_c/Geometry/body/leg_2_piston/leg_2_foot_contact>,
        </nova_c/Geometry/body/leg_2_piston/leg_2_touchdown_sensor>,
        </nova_c/Geometry/body/leg_3_piston>,
        </nova_c/Geometry/body/leg_3_piston/leg_3_foot_contact>,
        </nova_c/Geometry/body/leg_3_piston/leg_3_touchdown_sensor>,
        </nova_c/Geometry/body/leg_4_piston>,
        </nova_c/Geometry/body/leg_4_piston/leg_4_foot_contact>,
        </nova_c/Geometry/body/leg_4_piston/leg_4_touchdown_sensor>,
        </nova_c/Geometry/body/leg_5_piston>,
        </nova_c/Geometry/body/leg_5_piston/leg_5_foot_contact>,
        </nova_c/Geometry/body/leg_5_piston/leg_5_touchdown_sensor>,
        </nova_c/Geometry/body/vr900_gimbal_x>,
        </nova_c/Geometry/body/vr900_gimbal_x/vr900>,
        </nova_c/Geometry/body/vr900_gimbal_x/vr900/vr900_exit>,
    ]
    token isaac:robotType = "Aerial"
    string isaac:source = "lunar-surface-mobility-assets pipeline"
    string isaac:version = "0.1.1"

    over "Geometry"
    {
        over "body" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "leg_0_piston" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "leg_0_foot_contact" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Footpad contact point (touchdown sensing)"
                    uniform token isaac:forwardAxis = "Z"
                }

                over "leg_0_touchdown_sensor" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Crush-core stroke / touchdown switch (estimated)"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "leg_1_piston" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "leg_1_foot_contact" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Footpad contact point (touchdown sensing)"
                    uniform token isaac:forwardAxis = "Z"
                }

