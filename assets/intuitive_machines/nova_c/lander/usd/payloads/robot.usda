                    )
                    {
                        string isaac:Description = "Intuitive Machines VR900, helium pressure-fed, throttleable, 2-axis gimbal (IM). Throttle floor, gimbal range and exit size estimated."
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "top_array_normal" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Top-deck solar array centre; +Z = cell normal"
                uniform token isaac:forwardAxis = "Z"
            }

            over "vr900_gimbal_center" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
