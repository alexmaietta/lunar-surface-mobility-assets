#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "viper"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "viper" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "NASA VIPER"
    token isaac:license = "Other"
    string isaac:namespace = "viper"
    prepend rel isaac:physics:robotJoints = [
        </viper/Physics/fl_lower_arm>,
        </viper/Physics/fl_upright>,
        </viper/Physics/fl_steer>,
        </viper/Physics/fl_wheel>,
        </viper/Physics/fl_upper_arm>,
        </viper/Physics/fr_lower_arm>,
        </viper/Physics/fr_upright>,
        </viper/Physics/fr_steer>,
        </viper/Physics/fr_wheel>,
        </viper/Physics/fr_upper_arm>,
        </viper/Physics/hga_azimuth>,
        </viper/Physics/hga_elevation>,
        </viper/Physics/nav_mast_pan>,
        </viper/Physics/nav_mast_tilt>,
        </viper/Physics/nav_cam_left_cover>,
        </viper/Physics/nav_cam_right_cover>,
        </viper/Physics/rl_lower_arm>,
        </viper/Physics/rl_upright>,
        </viper/Physics/rl_steer>,
        </viper/Physics/rl_wheel>,
        </viper/Physics/rl_upper_arm>,
        </viper/Physics/rr_lower_arm>,
        </viper/Physics/rr_upright>,
        </viper/Physics/rr_steer>,
        </viper/Physics/rr_wheel>,
        </viper/Physics/rr_upper_arm>,
        </viper/Physics/trident_deploy>,
        </viper/Physics/trident_feed>,
        </viper/Physics/trident_auger>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </viper/Geometry/chassis>,
        </viper/Geometry/chassis/haz_light_fl>,
        </viper/Geometry/chassis/haz_light_fr>,
        </viper/Geometry/chassis/haz_light_rl>,
        </viper/Geometry/chassis/haz_light_rr>,
        </viper/Geometry/chassis/haz_light_front>,
        </viper/Geometry/chassis/haz_light_aft>,
        </viper/Geometry/chassis/nirvss_led_340>,
        </viper/Geometry/chassis/nirvss_led_410>,
        </viper/Geometry/chassis/nirvss_led_540>,
        </viper/Geometry/chassis/nirvss_led_640>,
        </viper/Geometry/chassis/nirvss_led_740>,
        </viper/Geometry/chassis/nirvss_led_905>,
        </viper/Geometry/chassis/nirvss_led_940>,
        </viper/Geometry/chassis/lift_point>,
        </viper/Geometry/chassis/vehicle_origin>,
        </viper/Geometry/chassis/imu>,
        </viper/Geometry/chassis/fl_lower_arm>,
        </viper/Geometry/chassis/fl_lower_arm/fl_upright>,
        </viper/Geometry/chassis/fl_lower_arm/fl_upright/fl_steer>,
        </viper/Geometry/chassis/fl_lower_arm/fl_upright/fl_steer/fl_wheel>,
        </viper/Geometry/chassis/fl_lower_arm/fl_upright/fl_steer/fl_wheel/fl_contact>,
        </viper/Geometry/chassis/fl_lower_arm/fl_upright/fl_steer/fl_wheel/fl_hub>,
        </viper/Geometry/chassis/fl_upper_arm>,
        </viper/Geometry/chassis/fr_lower_arm>,
        </viper/Geometry/chassis/fr_lower_arm/fr_upright>,
        </viper/Geometry/chassis/fr_lower_arm/fr_upright/fr_steer>,
        </viper/Geometry/chassis/fr_lower_arm/fr_upright/fr_steer/fr_wheel>,
        </viper/Geometry/chassis/fr_lower_arm/fr_upright/fr_steer/fr_wheel/fr_contact>,
        </viper/Geometry/chassis/fr_lower_arm/fr_upright/fr_steer/fr_wheel/fr_hub>,
        </viper/Geometry/chassis/fr_upper_arm>,
        </viper/Geometry/chassis/hga_azimuth>,
        </viper/Geometry/chassis/hga_azimuth/hga_elevation>,
        </viper/Geometry/chassis/hga_azimuth/hga_elevation/hga_boresight>,
        </viper/Geometry/chassis/nav_mast_pan>,
        </viper/Geometry/chassis/nav_mast_pan/nav_mast_tilt>,
        </viper/Geometry/chassis/nav_mast_pan/nav_mast_tilt/nav_light_l>,
        </viper/Geometry/chassis/nav_mast_pan/nav_mast_tilt/nav_light_r>,
        </viper/Geometry/chassis/nav_mast_pan/nav_mast_tilt/nav_cam_left_cover>,
        </viper/Geometry/chassis/nav_mast_pan/nav_mast_tilt/nav_cam_right_cover>,
        </viper/Geometry/chassis/rl_lower_arm>,
        </viper/Geometry/chassis/rl_lower_arm/rl_upright>,
        </viper/Geometry/chassis/rl_lower_arm/rl_upright/rl_steer>,
        </viper/Geometry/chassis/rl_lower_arm/rl_upright/rl_steer/rl_wheel>,
        </viper/Geometry/chassis/rl_lower_arm/rl_upright/rl_steer/rl_wheel/rl_contact>,
        </viper/Geometry/chassis/rl_lower_arm/rl_upright/rl_steer/rl_wheel/rl_hub>,
        </viper/Geometry/chassis/rl_upper_arm>,
        </viper/Geometry/chassis/rr_lower_arm>,
        </viper/Geometry/chassis/rr_lower_arm/rr_upright>,
        </viper/Geometry/chassis/rr_lower_arm/rr_upright/rr_steer>,
        </viper/Geometry/chassis/rr_lower_arm/rr_upright/rr_steer/rr_wheel>,
        </viper/Geometry/chassis/rr_lower_arm/rr_upright/rr_steer/rr_wheel/rr_contact>,
        </viper/Geometry/chassis/rr_lower_arm/rr_upright/rr_steer/rr_wheel/rr_hub>,
        </viper/Geometry/chassis/rr_upper_arm>,
        </viper/Geometry/chassis/trident_deploy>,
        </viper/Geometry/chassis/trident_deploy/trident_feed>,
        </viper/Geometry/chassis/trident_deploy/trident_feed/trident_bit>,
        </viper/Geometry/chassis/trident_deploy/trident_feed/trident_auger>,
    ]
    token isaac:robotType = "Wheeled"
    string isaac:source = "lunar-surface-mobility-assets pipeline"
    string isaac:version = "0.3.0"

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "fl_lower_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fl_upright" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fl_steer" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fl_wheel" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "fl_contact" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                                string isaac:Description = "Nominal tyre contact point"
                                uniform token isaac:forwardAxis = "Z"
                            }

                            over "fl_hub" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                                string isaac:Description = "Wheel centre; +Z = outboard axle"
                                uniform token isaac:forwardAxis = "Z"
                            }
                        }
                    }
                }
            }

            over "fl_upper_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "fr_lower_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fr_upright" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fr_steer" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fr_wheel" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "fr_contact" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                                string isaac:Description = "Nominal tyre contact point"
                                uniform token isaac:forwardAxis = "Z"
                            }

                            over "fr_hub" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                                string isaac:Description = "Wheel centre; +Z = outboard axle"
                                uniform token isaac:forwardAxis = "Z"
                            }
                        }
                    }
                }
            }

            over "fr_upper_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "hga_azimuth" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "hga_elevation" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "hga_boresight" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "High-gain antenna boresight (+Z), 2-axis gimbal"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "nav_mast_pan" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "nav_mast_tilt" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "nav_cam_left_cover" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }

                    over "nav_cam_right_cover" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }

                    over "nav_light_l" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "VIPER NavLight, 457 nm LED array with parabolic reflector"
                        uniform token isaac:forwardAxis = "Z"
                    }

                    over "nav_light_r" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "VIPER NavLight, 457 nm LED array with parabolic reflector"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "rl_lower_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rl_upright" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "rl_steer" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "rl_wheel" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "rl_contact" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                                string isaac:Description = "Nominal tyre contact point"
                                uniform token isaac:forwardAxis = "Z"
                            }

                            over "rl_hub" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                                string isaac:Description = "Wheel centre; +Z = outboard axle"
                                uniform token isaac:forwardAxis = "Z"
                            }
                        }
                    }
                }
            }

            over "rl_upper_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rr_lower_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rr_upright" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "rr_steer" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "rr_wheel" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "rr_contact" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                                string isaac:Description = "Nominal tyre contact point"
                                uniform token isaac:forwardAxis = "Z"
                            }

                            over "rr_hub" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                                string isaac:Description = "Wheel centre; +Z = outboard axle"
                                uniform token isaac:forwardAxis = "Z"
                            }
                        }
                    }
                }
            }

            over "rr_upper_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "trident_deploy" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "trident_feed" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "trident_auger" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }

                    over "trident_bit" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "TRIDENT 25.4 mm bit (1.02 m max depth)"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "haz_light_fl" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "VIPER HazLight, 457 nm LED with side-throw internal reflector"
                uniform token isaac:forwardAxis = "Z"
            }

            over "haz_light_fr" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "VIPER HazLight, 457 nm LED with side-throw internal reflector"
                uniform token isaac:forwardAxis = "Z"
            }

            over "haz_light_rl" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "VIPER HazLight, 457 nm LED with side-throw internal reflector"
                uniform token isaac:forwardAxis = "Z"
            }

            over "haz_light_rr" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "VIPER HazLight, 457 nm LED with side-throw internal reflector"
                uniform token isaac:forwardAxis = "Z"
            }

            over "haz_light_front" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "VIPER HazLight, 457 nm LED with side-throw internal reflector"
                uniform token isaac:forwardAxis = "Z"
            }

            over "haz_light_aft" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "VIPER HazLight, 457 nm LED with side-throw internal reflector"
                uniform token isaac:forwardAxis = "Z"
            }

            over "nirvss_led_340" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "NIRVSS AIM illumination LED set, 340 nm"
                uniform token isaac:forwardAxis = "Z"
            }

            over "nirvss_led_410" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "NIRVSS AIM illumination LED set, 410 nm"
                uniform token isaac:forwardAxis = "Z"
            }

            over "nirvss_led_540" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "NIRVSS AIM illumination LED set, 540 nm"
                uniform token isaac:forwardAxis = "Z"
            }

            over "nirvss_led_640" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "NIRVSS AIM illumination LED set, 640 nm"
                uniform token isaac:forwardAxis = "Z"
            }

            over "nirvss_led_740" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "NIRVSS AIM illumination LED set, 740 nm"
                uniform token isaac:forwardAxis = "Z"
            }

            over "nirvss_led_905" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "NIRVSS AIM illumination LED set, 905 nm"
                uniform token isaac:forwardAxis = "Z"
            }

            over "nirvss_led_940" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "NIRVSS AIM illumination LED set, 940 nm"
                uniform token isaac:forwardAxis = "Z"
            }

            over "lift_point" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Deck lift point"
                uniform token isaac:forwardAxis = "Z"
            }

            over "vehicle_origin" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Ground point under the chassis centre at nominal ride height"
                uniform token isaac:forwardAxis = "Z"
            }

            over "imu" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IMU / navigation reference (estimated)"
                uniform token isaac:forwardAxis = "Z"
            }
        }
    }

    over "Physics"
    {
        over "fl_lower_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fl_upright" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [0]
        }

        over "fl_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fl_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fl_upper_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [0]
        }

        over "fr_lower_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
