#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "viper"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "viper" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "NASA VIPER"
    token isaac:license = "Other"
    string isaac:namespace = "viper"
    prepend rel isaac:physics:robotJoints = [
        </viper/Physics/fl_arm>,
        </viper/Physics/fl_steer>,
        </viper/Physics/fl_wheel>,
        </viper/Physics/fr_arm>,
        </viper/Physics/fr_steer>,
        </viper/Physics/fr_wheel>,
        </viper/Physics/hga_azimuth>,
        </viper/Physics/hga_elevation>,
        </viper/Physics/nav_mast_pan>,
        </viper/Physics/nav_mast_tilt>,
        </viper/Physics/rl_arm>,
        </viper/Physics/rl_steer>,
        </viper/Physics/rl_wheel>,
        </viper/Physics/rr_arm>,
        </viper/Physics/rr_steer>,
        </viper/Physics/rr_wheel>,
        </viper/Physics/trident_drill>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </viper/Geometry/chassis>,
        </viper/Geometry/chassis/haz_light_fl>,
        </viper/Geometry/chassis/haz_light_fr>,
        </viper/Geometry/chassis/haz_light_fc>,
        </viper/Geometry/chassis/haz_light_al>,
        </viper/Geometry/chassis/haz_light_ar>,
        </viper/Geometry/chassis/haz_cam_front>,
        </viper/Geometry/chassis/lift_point>,
        </viper/Geometry/chassis/vehicle_origin>,
        </viper/Geometry/chassis/imu>,
        </viper/Geometry/chassis/fl_arm>,
        </viper/Geometry/chassis/fl_arm/fl_steer>,
        </viper/Geometry/chassis/fl_arm/fl_steer/fl_wheel>,
        </viper/Geometry/chassis/fl_arm/fl_steer/fl_wheel/fl_contact>,
        </viper/Geometry/chassis/fl_arm/fl_steer/fl_wheel/fl_hub>,
        </viper/Geometry/chassis/fr_arm>,
        </viper/Geometry/chassis/fr_arm/fr_steer>,
        </viper/Geometry/chassis/fr_arm/fr_steer/fr_wheel>,
        </viper/Geometry/chassis/fr_arm/fr_steer/fr_wheel/fr_contact>,
        </viper/Geometry/chassis/fr_arm/fr_steer/fr_wheel/fr_hub>,
        </viper/Geometry/chassis/hga_azimuth>,
        </viper/Geometry/chassis/hga_azimuth/hga_elevation>,
        </viper/Geometry/chassis/hga_azimuth/hga_elevation/hga_boresight>,
        </viper/Geometry/chassis/nav_mast_pan>,
        </viper/Geometry/chassis/nav_mast_pan/nav_mast_tilt>,
        </viper/Geometry/chassis/nav_mast_pan/nav_mast_tilt/nav_light_l>,
        </viper/Geometry/chassis/nav_mast_pan/nav_mast_tilt/nav_light_r>,
        </viper/Geometry/chassis/rl_arm>,
        </viper/Geometry/chassis/rl_arm/rl_steer>,
        </viper/Geometry/chassis/rl_arm/rl_steer/rl_wheel>,
        </viper/Geometry/chassis/rl_arm/rl_steer/rl_wheel/rl_contact>,
        </viper/Geometry/chassis/rl_arm/rl_steer/rl_wheel/rl_hub>,
        </viper/Geometry/chassis/rr_arm>,
        </viper/Geometry/chassis/rr_arm/rr_steer>,
        </viper/Geometry/chassis/rr_arm/rr_steer/rr_wheel>,
        </viper/Geometry/chassis/rr_arm/rr_steer/rr_wheel/rr_contact>,
        </viper/Geometry/chassis/rr_arm/rr_steer/rr_wheel/rr_hub>,
        </viper/Geometry/chassis/trident_drill>,
        </viper/Geometry/chassis/trident_drill/trident_bit>,
    ]
    token isaac:robotType = "Wheeled"
    string isaac:source = "lunar-surface-mobility-assets pipeline"
    string isaac:version = "0.1.1"

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "fl_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fl_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fl_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fl_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "fl_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "fr_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fr_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fr_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fr_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "fr_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "hga_azimuth" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "hga_elevation" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "hga_boresight" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "High-gain antenna boresight (+Z), 2-axis gimbal"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "nav_mast_pan" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "nav_mast_tilt" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "nav_light_l" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "Floodlight (+Z = beam axis)"
                        uniform token isaac:forwardAxis = "Z"
                    }

                    over "nav_light_r" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "Floodlight (+Z = beam axis)"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "rl_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rl_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "rl_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "rl_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "rl_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "rr_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rr_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "rr_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "rr_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "rr_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "trident_drill" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "trident_bit" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "TRIDENT drill bit (1 m depth)"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "haz_light_fl" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "haz_light_fr" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "haz_light_fc" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "haz_light_al" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "haz_light_ar" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "haz_cam_front" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Front hazard camera pair (estimated)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "lift_point" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Deck lift point"
                uniform token isaac:forwardAxis = "Z"
            }

            over "vehicle_origin" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Ground point under the chassis centre at nominal ride height"
                uniform token isaac:forwardAxis = "Z"
            }

            over "imu" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IMU / navigation reference (estimated)"
                uniform token isaac:forwardAxis = "Z"
            }
        }
    }

    over "Physics"
    {
        over "fl_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fl_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fl_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fr_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fr_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fr_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "hga_azimuth" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "hga_elevation" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "nav_mast_pan" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "nav_mast_tilt" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rl_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rl_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rl_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rr_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rr_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rr_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "trident_drill" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }
    }
}

