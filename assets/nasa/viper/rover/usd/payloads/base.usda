def Xform "viper" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./viper.usda@
        string name = "viper"
        string version = "0.3.0"
    }
    doc = "NASA VIPER (Volatiles Investigating Polar Exploration Rover), flight design for Blue Moon MK1 delivery: 1.7 x 1.7 x 2.5 m and 447 kg roving. Silver-MLI body over a narrower lower warm box, solar arrays hanging from the port, starboard and aft deck edges, four OSR radiators on a peaked deck, a front-port mast with the NavCam stereo pair (40 cm baseline) and two 457 nm NavLight LED panels on a pan-tilt gimbal at 2.0 m and a flat high-gain antenna on its own gimbal at 2.3 m, the TRIDENT drill chimney with calibration targets, aft stereo cameras, four wheel-well HazCams and six HazLights. Four 0.5 m wire-spoked grousered drum wheels, each on an active four-bar suspension (360 mm stroke, 7-43 cm clearance) with +/-50 deg offset-kingpin steering and hub drive. Lights carry measured spectra and lumens (UsdLux plus Omniverse RTX photometric schemas); cameras carry the VIS monochrome responsivity."
    kind = "component"
)
