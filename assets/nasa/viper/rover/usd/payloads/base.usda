        string version = "0.1.1"
    }
    doc = "NASA VIPER (Volatiles Investigating Polar Exploration Rover), flight design for Blue Moon MK1 delivery: 1.7 x 1.7 x 2.5 m and 447 kg roving, a silver-MLI body with solar arrays hanging from the port, starboard and aft deck edges, deck radiators, a front mast with a gimballed navigation camera and light bar at 2.0 m and a high-gain antenna at 2.3 m, the TRIDENT 1 m drill on the front-right corner, and four 0.5 m grousered wheels, each on an active swing-arm suspension (wheel walking, 7-43 cm clearance) with +/-50 deg steering and hub drive."
