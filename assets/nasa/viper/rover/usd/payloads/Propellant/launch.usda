        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 0.62)
            float3 physics:diagonalInertia = (116.54134, 116.54134, 167.61003)
            float physics:mass = 392.836
            custom string propellant:source = "NASA: 490 kg at launch"
        }
    }
}

