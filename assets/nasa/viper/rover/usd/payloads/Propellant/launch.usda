#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "viper"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "viper"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 0.8)
            float3 physics:diagonalInertia = (121.681984, 121.681984, 175.00331)
            float physics:mass = 410.164
            custom string propellant:source = "NASA: 490 kg at launch"
        }
    }
}

