#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "viper"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

