#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "viper"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "viper"
{
    over "Physics"
    {
        over "fl_lower_arm" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_lower_arm_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -8852.6953125, -240.37635407028912, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 1180.359375
            uniform double mjc:forceRange:min = -1180.359375
            uniform double[] mjc:gainPrm = [8852.6953125, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </viper/Physics/fl_lower_arm>
        }

        over "fl_upright" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "MjcJointAPI"]
