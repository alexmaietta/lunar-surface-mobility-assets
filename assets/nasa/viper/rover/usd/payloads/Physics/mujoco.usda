        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_wheel_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -670.5, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 54.478125
            uniform double mjc:forceRange:min = -54.478125
            uniform double[] mjc:gainPrm = [670.5, 0, 0, 0, 0, 0, 0, 0, 0, 0]
