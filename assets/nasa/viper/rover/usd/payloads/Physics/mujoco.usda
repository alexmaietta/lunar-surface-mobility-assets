#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "viper"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "viper"
{
    over "Physics"
    {
        over "fl_arm" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_arm_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -8171.71875, -266.47630473927694, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 1089.5625
            uniform double mjc:forceRange:min = -1089.5625
            uniform double[] mjc:gainPrm = [8171.71875, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </viper/Physics/fl_arm>
        }

        over "fl_steer" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_steer_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -4470, -447, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 335.25
            uniform double mjc:forceRange:min = -335.25
            uniform double[] mjc:gainPrm = [4470, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </viper/Physics/fl_steer>
        }

        over "fl_wheel" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
