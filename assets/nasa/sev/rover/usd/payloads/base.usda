        asset identifier = @./sev.usda@
        string name = "sev"
        string version = "0.1.0"
    }
    doc = "NASA Space Exploration Vehicle / Lunar Electric Rover (2010 Gen 1B, Desert RATS): a white composite pressurised cabin on the Chariot chassis, 4.9 m long over the wheels and 3 m tall at the roof, with twelve wheels on six gold steering columns that pivot 360 deg (crab steering and turn-in-place) on active-suspension legs able to kneel. Two hinged suitport hatches on the D-shaped aft bulkhead (optional inflatable suitport cover), a hinged side docking hatch over the middle module, forward windows with a lower bubble window, an aft driving deck with a standing station, roof LED light bars, a copper hand-rail hoop and camera masts."
    kind = "component"
)
