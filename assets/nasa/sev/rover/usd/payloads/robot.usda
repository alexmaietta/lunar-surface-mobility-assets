#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "sev"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "sev" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "NASA Space Exploration Vehicle (SEV)"
    token isaac:license = "Other"
    string isaac:namespace = "sev"
    prepend rel isaac:physics:robotJoints = [
        </sev/Physics/docking_hatch>,
        </sev/Physics/leg_al>,
        </sev/Physics/al_steer>,
        </sev/Physics/al_dual_wheel>,
