#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "sev"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "sev"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0.2, 0, 1.3)
            float3 physics:diagonalInertia = (2936.0771, 6786.191, 6911.0737)
            float physics:mass = 3188.5
            custom string propellant:source = "NASA: + 1,000 kg payload"
        }
    }
}

