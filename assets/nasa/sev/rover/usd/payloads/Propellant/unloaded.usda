#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "sev"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "sev"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0.4, 0, 1.35)
            float3 physics:diagonalInertia = (2015.2438, 4657.8574, 4743.5737)
            float physics:mass = 2188.5
            custom string propellant:source = "NASA: about 3,000 kg including the 1,000 kg Chariot"
        }
    }
}

