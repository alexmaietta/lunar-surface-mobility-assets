            quatf physics:localRot0 = (0.70710677, 0, 0, -0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, -0.70710677)
            float physics:lowerLimit = -60.16057
            float physics:upperLimit = 60.16057
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "front_drums" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.34906584
            float drive:angular:physics:maxForce = 50
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "velocity"
            custom uniform token joint:role = "excavate"
            uniform token physics:axis = "X"
            rel physics:body0 = </ipex/Geometry/chassis/front_arm>
            rel physics:body1 = </ipex/Geometry/chassis/front_arm/front_drums>
            point3f physics:localPos0 = (0.27577597, 0, 0.23140353)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "radiator_cover" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.008726646
            float drive:angular:physics:maxForce = 5
            float drive:angular:physics:stiffness = 0.08726646
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "position"
            custom uniform token joint:role = "hatch"
            uniform token physics:axis = "X"
            rel physics:body0 = </ipex/Geometry/chassis>
            rel physics:body1 = </ipex/Geometry/chassis/radiator_cover>
            point3f physics:localPos0 = (-0.135, 0, 0.256)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, -0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, -0.70710677)
            float physics:lowerLimit = 0
            float physics:upperLimit = 90
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "rear_arm" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.6981317
