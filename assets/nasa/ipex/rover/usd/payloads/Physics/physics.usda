#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "ipex"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "ipex"
{
    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0, 0, 0.21)
            float3 physics:diagonalInertia = (0.10391667, 0.13079166, 0.20245834)
            float physics:mass = 8.6
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "fl_wheel" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (7.450581e-9, 0, 0)
                float3 physics:diagonalInertia = (0.010867696, 0.018260166, 0.010867696)
                float physics:mass = 1
                quatf physics:principalAxes = (1, 0, 0, 0)
            }

            over "fr_wheel" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (7.450581e-9, 0, 0)
                float3 physics:diagonalInertia = (0.010867696, 0.018260166, 0.010867696)
                float physics:mass = 1
                quatf physics:principalAxes = (1, 0, 0, 0)
            }

            over "front_arm" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0.1504682, 0, 0.11870177)
                float3 physics:diagonalInertia = (0.014453624, 0.030732196, 0.019999571)
                float physics:mass = 1.5
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "front_drums" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (1.4901161e-8, 0, 1.4901161e-8)
                    float3 physics:diagonalInertia = (0.30051196, 0.11475797, 0.30051196)
                    float physics:mass = 7
                    quatf physics:principalAxes = (1, 0, 0, 0)
                }
            }

            over "radiator_cover" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0.1315, 0, 0.014999986)
                float3 physics:diagonalInertia = (0.0024945335, 0.0026221666, 0.004987634)
                float physics:mass = 0.4
                quatf physics:principalAxes = (1, 0, 0, 0)
            }

            over "rear_arm" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (-0.1504682, 0, 0.11870177)
                float3 physics:diagonalInertia = (0.014453624, 0.030732196, 0.019999571)
                float physics:mass = 1.5
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "rear_drums" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (-1.4901161e-8, 0, 1.4901161e-8)
                    float3 physics:diagonalInertia = (0.30051196, 0.11475797, 0.30051196)
                    float physics:mass = 7
                    quatf physics:principalAxes = (1, 0, 0, 0)
                }
            }

            over "rl_wheel" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (-7.450581e-9, 0, 0)
                float3 physics:diagonalInertia = (0.010867696, 0.018260166, 0.010867696)
                float physics:mass = 1
                quatf physics:principalAxes = (1, 0, 0, 0)
            }

            over "rr_wheel" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (-7.450581e-9, 0, 0)
                float3 physics:diagonalInertia = (0.010867696, 0.018260166, 0.010867696)
                float physics:mass = 1
                quatf physics:principalAxes = (1, 0, 0, 0)
            }
        }
    }

    def "Physics"
    {
        def PhysicsRevoluteJoint "fl_wheel" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.7853982
            float drive:angular:physics:maxForce = 15
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "velocity"
            custom uniform token joint:role = "drive"
            uniform token physics:axis = "X"
            rel physics:body0 = </ipex/Geometry/chassis>
            rel physics:body1 = </ipex/Geometry/chassis/fl_wheel>
            point3f physics:localPos0 = (0.233, 0.255, 0.1655)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "fr_wheel" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.7853982
            float drive:angular:physics:maxForce = 15
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "velocity"
            custom uniform token joint:role = "drive"
            uniform token physics:axis = "X"
            rel physics:body0 = </ipex/Geometry/chassis>
            rel physics:body1 = </ipex/Geometry/chassis/fr_wheel>
            point3f physics:localPos0 = (0.233, -0.255, 0.1655)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "front_arm" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.6981317
            float drive:angular:physics:maxForce = 60
            float drive:angular:physics:stiffness = 6.981317
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
