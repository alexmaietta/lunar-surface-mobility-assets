#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "ipex"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "ipex"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 0.21)
            float3 physics:diagonalInertia = (0.10391667, 0.13079166, 0.20245834)
            float physics:mass = 8.6
            custom string propellant:source = "NASA: 30 kg-class excavator (TRL 5 paper)"
        }
    }
}

