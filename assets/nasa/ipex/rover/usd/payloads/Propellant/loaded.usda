#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "ipex"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "ipex"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 0.28)
            float3 physics:diagonalInertia = (0.46641666, 0.5870417, 0.90870833)
            float physics:mass = 38.6
            custom string propellant:source = "30 kg vehicle plus 30 kg of regolith in the four drums (TRL 5 paper: up to 30 kg per cycle)"
        }
    }
}

