#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "ipex"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "ipex" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "NASA IPEx excavator"
    token isaac:license = "Other"
    string isaac:namespace = "ipex"
    prepend rel isaac:physics:robotJoints = [
        </ipex/Physics/fl_wheel>,
        </ipex/Physics/fr_wheel>,
        </ipex/Physics/front_arm>,
        </ipex/Physics/front_drums>,
        </ipex/Physics/radiator_cover>,
        </ipex/Physics/rear_arm>,
        </ipex/Physics/rear_drums>,
        </ipex/Physics/rl_wheel>,
        </ipex/Physics/rr_wheel>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </ipex/Geometry/chassis>,
        </ipex/Geometry/chassis/front_light_o>,
        </ipex/Geometry/chassis/front_light_i>,
        </ipex/Geometry/chassis/rear_light_i>,
        </ipex/Geometry/chassis/rear_light_o>,
        </ipex/Geometry/chassis/side_light_r>,
        </ipex/Geometry/chassis/side_light_l>,
        </ipex/Geometry/chassis/lift_point>,
        </ipex/Geometry/chassis/vehicle_origin>,
        </ipex/Geometry/chassis/imu>,
        </ipex/Geometry/chassis/fl_wheel>,
        </ipex/Geometry/chassis/fl_wheel/fl_contact>,
        </ipex/Geometry/chassis/fl_wheel/fl_hub>,
        </ipex/Geometry/chassis/fr_wheel>,
        </ipex/Geometry/chassis/fr_wheel/fr_contact>,
        </ipex/Geometry/chassis/fr_wheel/fr_hub>,
        </ipex/Geometry/chassis/front_arm>,
        </ipex/Geometry/chassis/front_arm/front_drums_cut>,
        </ipex/Geometry/chassis/front_arm/front_drums>,
        </ipex/Geometry/chassis/front_arm/front_drums/front_drums_volume>,
        </ipex/Geometry/chassis/radiator_cover>,
        </ipex/Geometry/chassis/radiator_cover/charger_coil>,
        </ipex/Geometry/chassis/rear_arm>,
        </ipex/Geometry/chassis/rear_arm/rear_drums_cut>,
        </ipex/Geometry/chassis/rear_arm/rear_drums>,
        </ipex/Geometry/chassis/rear_arm/rear_drums/rear_drums_volume>,
        </ipex/Geometry/chassis/rl_wheel>,
        </ipex/Geometry/chassis/rl_wheel/rl_contact>,
        </ipex/Geometry/chassis/rl_wheel/rl_hub>,
        </ipex/Geometry/chassis/rr_wheel>,
        </ipex/Geometry/chassis/rr_wheel/rr_contact>,
        </ipex/Geometry/chassis/rr_wheel/rr_hub>,
    ]
    token isaac:robotType = "Wheeled"
    string isaac:source = "lunar-surface-mobility-assets pipeline"
    string isaac:version = "0.2.0"

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "fl_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fl_contact" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Nominal tyre contact point"
                    uniform token isaac:forwardAxis = "Z"
                }

                over "fl_hub" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Wheel centre; +Z = outboard axle"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "fr_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fr_contact" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Nominal tyre contact point"
                    uniform token isaac:forwardAxis = "Z"
                }

                over "fr_hub" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Wheel centre; +Z = outboard axle"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "front_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "front_drums" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "front_drums_volume" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "Bucket-drum pair regolith store (two drums, spiral-baffle channels between the outer shells and the inner spiral turns)"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }

                over "front_drums_cut" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Front bucket-drum pair, lowest scoop lip (cutting edge when digging)"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "radiator_cover" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "charger_coil" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "WiBotic wireless-charging receive coil (dock under the lander transmitter)"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "rear_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rear_drums" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "rear_drums_volume" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "Bucket-drum pair regolith store (two drums, spiral-baffle channels between the outer shells and the inner spiral turns)"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }

                over "rear_drums_cut" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Rear bucket-drum pair, lowest scoop lip (cutting edge when digging)"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "rl_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rl_contact" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Nominal tyre contact point"
                    uniform token isaac:forwardAxis = "Z"
                }

                over "rl_hub" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Wheel centre; +Z = outboard axle"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "rr_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rr_contact" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Nominal tyre contact point"
                    uniform token isaac:forwardAxis = "Z"
                }

                over "rr_hub" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Wheel centre; +Z = outboard axle"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "front_light_o" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IPEx LED light unit (3 LEDs)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "front_light_i" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IPEx LED light unit (3 LEDs)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "rear_light_i" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IPEx LED light unit (3 LEDs)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "rear_light_o" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IPEx LED light unit (3 LEDs)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "side_light_r" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IPEx LED light unit (3 LEDs)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "side_light_l" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IPEx LED light unit (3 LEDs)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "lift_point" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Knurled lift knob"
                uniform token isaac:forwardAxis = "Z"
            }

            over "vehicle_origin" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Ground point under the chassis centre at nominal ride height"
                uniform token isaac:forwardAxis = "Z"
            }

            over "imu" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IMU / navigation reference (estimated)"
                uniform token isaac:forwardAxis = "Z"
            }
        }
    }

    over "Physics"
    {
        over "fl_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fr_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "front_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "front_drums" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "radiator_cover" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rear_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rear_drums" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rl_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rr_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }
    }
}

