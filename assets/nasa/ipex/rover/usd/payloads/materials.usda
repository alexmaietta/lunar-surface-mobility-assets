            color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
            float inputs:ior = 1.5
            float inputs:metallic = 0.6
            float inputs:opacity = 1
            float inputs:roughness = 0.6
            float inputs:specular = 0.5
            token outputs:surface
        }
    }

