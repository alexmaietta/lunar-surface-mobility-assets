#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "ipex"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "ipex"
{
    over "Geometry"
    {
        over "chassis"
        {
            over "fl_wheel" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "fr_wheel" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "front_arm" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                over "front_drums" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                }
            }

            over "radiator_cover" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "rear_arm" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                over "rear_drums" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                }
            }

            over "rl_wheel" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "rr_wheel" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "fl_wheel" (
            active = false
        )
        {
        }

        over "fl_wheel_actuator" (
            active = false
        )
        {
        }

        over "fr_wheel" (
            active = false
        )
        {
        }

        over "fr_wheel_actuator" (
            active = false
        )
        {
        }

        over "front_arm" (
            active = false
        )
        {
        }

        over "front_arm_actuator" (
            active = false
        )
        {
        }

        over "front_drums" (
            active = false
        )
        {
        }

        over "front_drums_actuator" (
            active = false
        )
        {
        }

        over "radiator_cover" (
            active = false
        )
        {
        }

        over "radiator_cover_actuator" (
            active = false
        )
        {
        }

        over "rear_arm" (
            active = false
        )
        {
        }

        over "rear_arm_actuator" (
            active = false
        )
        {
        }

        over "rear_drums" (
            active = false
        )
        {
        }

        over "rear_drums_actuator" (
            active = false
        )
        {
        }

        over "rl_wheel" (
            active = false
        )
        {
        }

        over "rl_wheel_actuator" (
            active = false
        )
        {
        }

        over "rr_wheel" (
            active = false
        )
        {
        }

        over "rr_wheel_actuator" (
            active = false
        )
        {
        }
    }
}

