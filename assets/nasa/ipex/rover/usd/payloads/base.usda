def Xform "ipex" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./ipex.usda@
        string name = "ipex"
        string version = "0.2.0"
    }
    doc = "NASA KSC Swamp Works IPEx (ISRU, now Infrastructure, Pilot Excavator), TRL 5/6 design: a 30 kg-class regolith excavator, 1.33 x 0.64 x 0.57 m with its arms at the 40 deg driving pose. A white chassis with an actuated Cerakote radiator cover over a PCM heat sink and a wireless-charging receive coil, four 0.305 m skid-steered wheels with gold conversion-coated rings and spokes and perforated hard-anodised cleat plates, no suspension, and one arm at each end carrying a pair of 0.30 x 0.26 m billet-aluminium bucket drums on a through-shaft actuator. The front and rear drums dig in opposite directions so the excavation forces cancel; each cycle carries up to 30 kg of regolith, dumped by reversing the drums. Two 5 cm stereo pairs, four mono cameras and six LED lights."
    kind = "component"
)
{
