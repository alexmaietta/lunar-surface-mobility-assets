<?xml version="1.0" ?>
<robot name="dump_trailer">
  <link name="base_link"/>
  <joint name="base_link_to_base" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base">
    <inertial>
      <origin xyz="-0.0451 0 0.0012" rpy="0 0 0"/>
      <mass value="10"/>
      <inertia ixx="0.218053" ixy="0" ixz="0" iyy="0.0989784" iyz="0" izz="0.157278"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/base.obj"/>
      </geometry>
    </visual>
  </link>
  <link name="hitch_yaw">
    <inertial>
      <origin xyz="1.86265e-09 0 0" rpy="0 0 0"/>
      <mass value="4"/>
      <inertia ixx="0.0103834" ixy="0" ixz="0" iyy="0.0103834" iyz="0" izz="0.0103834"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/hitch_yaw.obj"/>
      </geometry>
    </visual>
  </link>
  <joint name="hitch_yaw" type="revolute">
    <parent link="base"/>
    <child link="hitch_yaw"/>
    <origin xyz="-0.12 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" velocity="6.28319" lower="-1.309" upper="1.309"/>
    <dynamics damping="5" friction="0"/>
  </joint>
  <link name="hitch_pitch">
    <inertial>
      <origin xyz="-1.2589 -0.000200003 -0.213" rpy="0 0 0"/>
      <mass value="75"/>
      <inertia ixx="28.5181" ixy="0" ixz="0" iyy="44.6827" iyz="0" izz="65.6658"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/hitch_pitch.obj"/>
      </geometry>
    </visual>
    <collision name="hitch_pitch_frame_col">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/hitch_pitch_frame_col.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="hitch_pitch" type="revolute">
    <parent link="hitch_yaw"/>
    <child link="hitch_pitch"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" velocity="6.28319" lower="-0.523599" upper="0.523599"/>
    <dynamics damping="5" friction="0"/>
  </joint>
  <link name="bed">
    <inertial>
      <origin xyz="0.7896 -0.00060001 0.297071" rpy="0 0 0"/>
      <mass value="70"/>
      <inertia ixx="14.7376" ixy="0" ixz="0" iyy="18.7608" iyz="0" izz="28.4983"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/bed.obj"/>
      </geometry>
    </visual>
    <collision name="bed_bed_col">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/bed_bed_col.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="bed" type="revolute">
    <parent link="hitch_pitch"/>
    <child link="bed"/>
    <origin xyz="-2.46 0 -0.07" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit effort="9000" velocity="6.28319" lower="0" upper="0.959931"/>
    <dynamics damping="3000" friction="0"/>
  </joint>
  <link name="trailer_l_wheel">
    <inertial>
      <origin xyz="5.96046e-08 0 -1.49012e-08" rpy="0 0 0"/>
      <mass value="14"/>
      <inertia ixx="0.635027" ixy="0" ixz="0" iyy="1.15381" iyz="0" izz="0.635026"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/trailer_l_wheel.obj"/>
      </geometry>
    </visual>
    <collision name="trailer_l_wheel_tyre_col">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/trailer_l_wheel_tyre_col.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="trailer_l_wheel" type="continuous">
    <parent link="hitch_pitch"/>
    <child link="trailer_l_wheel"/>
    <origin xyz="-1.83 0.85 -0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" velocity="6.28319"/>
    <dynamics damping="0.5" friction="0"/>
  </joint>
  <link name="trailer_r_wheel">
    <inertial>
      <origin xyz="5.96046e-08 0 -1.49012e-08" rpy="0 0 0"/>
      <mass value="14"/>
      <inertia ixx="0.631574" ixy="0" ixz="0" iyy="1.14857" iyz="0" izz="0.631574"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/trailer_r_wheel.obj"/>
      </geometry>
    </visual>
    <collision name="trailer_r_wheel_tyre_col">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/trailer_r_wheel_tyre_col.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="trailer_r_wheel" type="continuous">
    <parent link="hitch_pitch"/>
    <child link="trailer_r_wheel"/>
    <origin xyz="-1.83 -0.85 -0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" velocity="6.28319"/>
    <dynamics damping="0.5" friction="0"/>
  </joint>
</robot>
