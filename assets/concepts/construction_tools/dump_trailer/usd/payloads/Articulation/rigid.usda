#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "dump_trailer"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "dump_trailer"
{
    over "Geometry"
    {
        over "base"
        {
            over "hitch_yaw" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                over "hitch_pitch" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    over "bed" (
                        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                    }

                    over "trailer_l_wheel" (
                        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                    }

                    over "trailer_r_wheel" (
                        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "hitch_yaw" (
            active = false
        )
        {
        }

        over "hitch_yaw_actuator" (
            active = false
        )
        {
        }

        over "hitch_pitch" (
            active = false
        )
        {
        }

        over "hitch_pitch_actuator" (
            active = false
        )
        {
        }

        over "bed" (
            active = false
        )
        {
        }

        over "bed_actuator" (
            active = false
        )
        {
        }

        over "trailer_l_wheel" (
            active = false
        )
        {
        }

        over "trailer_l_wheel_actuator" (
            active = false
        )
        {
        }

        over "trailer_r_wheel" (
            active = false
        )
        {
        }

        over "trailer_r_wheel_actuator" (
            active = false
        )
        {
        }
    }
}

