#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "dump_trailer"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "dump_trailer"
{
    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (-0.045099996, 0, 0.001199998)
            float3 physics:diagonalInertia = (0.21805334, 0.09897844, 0.15727817)
            float physics:mass = 10
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "hitch_yaw" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (1.8626451e-9, 0, 0)
                float3 physics:diagonalInertia = (0.010383359, 0.010383359, 0.010383359)
                float physics:mass = 4
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "hitch_pitch" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (-1.2589, -0.00020000339, -0.21300003)
                    float3 physics:diagonalInertia = (28.518108, 44.682697, 65.66584)
                    float physics:mass = 75
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "bed" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        point3f physics:centerOfMass = (0.78959996, -0.00060001016, 0.29707116)
                        float3 physics:diagonalInertia = (14.737564, 18.760818, 28.498322)
                        float physics:mass = 70
                        quatf physics:principalAxes = (1, 0, 0, 0)
                    }

                    over "trailer_l_wheel" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        point3f physics:centerOfMass = (5.9604645e-8, 0, -1.4901161e-8)
                        float3 physics:diagonalInertia = (0.6350266, 1.1538105, 0.63502645)
                        float physics:mass = 14
                        quatf physics:principalAxes = (1, 0, 0, 0)
                    }

                    over "trailer_r_wheel" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        point3f physics:centerOfMass = (5.9604645e-8, 0, -1.4901161e-8)
                        float3 physics:diagonalInertia = (0.63157403, 1.148566, 0.6315739)
                        float physics:mass = 14
                        quatf physics:principalAxes = (1, 0, 0, 0)
                    }
                }
            }
        }
    }

    def "Physics"
    {
        def PhysicsRevoluteJoint "hitch_yaw" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.08726646
            float drive:angular:physics:maxForce = 1000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "none"
            custom uniform token joint:role = "hitch"
            uniform token physics:axis = "X"
            rel physics:body0 = </dump_trailer/Geometry/base>
            rel physics:body1 = </dump_trailer/Geometry/base/hitch_yaw>
            point3f physics:localPos0 = (-0.12, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
            quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
            float physics:lowerLimit = -75
            float physics:upperLimit = 75
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "hitch_pitch" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.08726646
            float drive:angular:physics:maxForce = 1000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "none"
            custom uniform token joint:role = "hitch"
            uniform token physics:axis = "X"
            rel physics:body0 = </dump_trailer/Geometry/base/hitch_yaw>
            rel physics:body1 = </dump_trailer/Geometry/base/hitch_yaw/hitch_pitch>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float physics:lowerLimit = -30
            float physics:upperLimit = 30
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "bed" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 52.35988
            float drive:angular:physics:maxForce = 9000
            float drive:angular:physics:stiffness = 523.59875
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "position"
            custom uniform token joint:role = "tool"
            uniform token physics:axis = "X"
            rel physics:body0 = </dump_trailer/Geometry/base/hitch_yaw/hitch_pitch>
            rel physics:body1 = </dump_trailer/Geometry/base/hitch_yaw/hitch_pitch/bed>
            point3f physics:localPos0 = (-2.46, 0, -0.07)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, -0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, -0.70710677)
            float physics:lowerLimit = 0
            float physics:upperLimit = 55
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "trailer_l_wheel" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.008726646
            float drive:angular:physics:maxForce = 1000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "none"
            custom uniform token joint:role = "free_wheel"
            uniform token physics:axis = "X"
            rel physics:body0 = </dump_trailer/Geometry/base/hitch_yaw/hitch_pitch>
            rel physics:body1 = </dump_trailer/Geometry/base/hitch_yaw/hitch_pitch/trailer_l_wheel>
            point3f physics:localPos0 = (-1.83, 0.85, -0.25)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "trailer_r_wheel" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.008726646
            float drive:angular:physics:maxForce = 1000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "none"
            custom uniform token joint:role = "free_wheel"
            uniform token physics:axis = "X"
            rel physics:body0 = </dump_trailer/Geometry/base/hitch_yaw/hitch_pitch>
            rel physics:body1 = </dump_trailer/Geometry/base/hitch_yaw/hitch_pitch/trailer_r_wheel>
            point3f physics:localPos0 = (-1.83, -0.85, -0.25)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }
}

