<?xml version="1.0" ?>
<robot name="rock_rake">
  <link name="base_link"/>
  <joint name="base_link_to_base" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base">
    <inertial>
      <origin xyz="0.131522 0.00139999 0.0194" rpy="0 0 0"/>
      <mass value="15"/>
      <inertia ixx="0.876432" ixy="0" ixz="0" iyy="0.278993" iyz="0" izz="0.860273"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/base.obj"/>
      </geometry>
    </visual>
  </link>
  <link name="rake_lift">
    <inertial>
      <origin xyz="0.47478 0 -0.244691" rpy="0 0 0"/>
      <mass value="55"/>
      <inertia ixx="30.3051" ixy="0" ixz="0" iyy="6.2576" iyz="0" izz="33.4644"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/rake_lift.obj"/>
      </geometry>
    </visual>
    <collision name="rake_lift_rake_col">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/rake_lift_rake_col.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="rake_lift" type="revolute">
    <parent link="base"/>
    <child link="rake_lift"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit effort="4000" velocity="6.28319" lower="-0.3" upper="0.45"/>
    <dynamics damping="3000" friction="0"/>
  </joint>
</robot>
