<?xml version="1.0" ?>
<robot name="ripper">
  <link name="base_link"/>
  <joint name="base_link_to_base" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base">
    <inertial>
      <origin xyz="-0.132811 0 0.0344394" rpy="0 0 0"/>
      <mass value="15"/>
      <inertia ixx="0.908756" ixy="0" ixz="0" iyy="0.308061" iyz="0" izz="0.867728"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/base.obj"/>
      </geometry>
    </visual>
  </link>
  <link name="ripper_lift">
    <inertial>
      <origin xyz="-0.445203 0 -0.210331" rpy="0 0 0"/>
      <mass value="70"/>
      <inertia ixx="19.2743" ixy="0" ixz="0" iyy="7.56863" iyz="0" izz="22.2972"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/ripper_lift.obj"/>
      </geometry>
    </visual>
    <collision name="ripper_lift_ripper_col">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/ripper_lift_ripper_col.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="ripper_lift" type="revolute">
    <parent link="base"/>
    <child link="ripper_lift"/>
    <origin xyz="-0.1 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="8000" velocity="6.28319" lower="-0.55" upper="0.35"/>
    <dynamics damping="5000" friction="0"/>
  </joint>
</robot>
