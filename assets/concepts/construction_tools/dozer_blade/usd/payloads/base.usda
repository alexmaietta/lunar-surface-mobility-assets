    assetInfo = {
        asset identifier = @./dozer_blade.usda@
        string name = "dozer_blade"
        string version = "0.3.0"
    }
    doc = "Front-mounted six-way dozer blade for Lunar Terrain Vehicle-class rovers, sized after NASA's LANCE blade on Chariot (composite moldboard on a light aluminium frame, about 70 % lighter than a steel blade). A quick-attach coupler carries an A-frame push arm on a lift pivot, and a C-frame on the arm nose gives power angle (yaw) and tilt (roll). The 2.7 m curved composite moldboard has a replaceable steel cutting edge and end bits. Use for clearing, grading, dozing and building berms and ramps."
    kind = "component"
)
