#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "v_blade"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "v_blade"
{
    over "Geometry"
    {
        over "base"
        {
            over "blade_lift" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                over "wing_l" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                }

                over "wing_r" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "blade_lift" (
            active = false
        )
        {
        }

        over "blade_lift_actuator" (
            active = false
        )
        {
        }

        over "wing_l" (
            active = false
        )
        {
        }

        over "wing_l_actuator" (
            active = false
        )
        {
        }

        over "wing_r" (
            active = false
        )
        {
        }

        over "wing_r_actuator" (
            active = false
        )
        {
        }
    }
}

