def Xform "drum_excavator" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./drum_excavator.usda@
        string name = "drum_excavator"
        string version = "0.3.0"
    }
    doc = "Front bucket-drum excavator for Lunar Terrain Vehicle-class rovers, after NASA's RASSOR and IPEx drums and the drum-excavator attachments shown on Astrolab FLEX by Astroport and Interlune. A pitching arm on the quick-attach coupler carries a pair of 0.54 m diameter, 0.62 m wide hollow drums on one powered shaft. Staggered scoops fill the drums when they turn one way at a shallow cut, so excavation forces stay low for a light vehicle, and reversing the drums dumps the load (about 0.10 m3, 150 kg)."
    kind = "component"
)
