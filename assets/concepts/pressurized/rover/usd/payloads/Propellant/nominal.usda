#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "pr_concept"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "pr_concept"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 1.75)
            float3 physics:diagonalInertia = (8082.1436, 25561.572, 25561.572)
            float physics:mass = 7173.5
            custom string propellant:source = "concept: 8-10 t two-crew pressurised rover, consumables for 14 days"
        }
    }
}

