#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "pr_concept"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "pr_concept"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 1.7)
            float3 physics:diagonalInertia = (9208.81, 29124.904, 29124.904)
            float physics:mass = 8173.5
            custom string propellant:source = "concept: + 2 crew, full consumables and 500 kg samples/payload"
        }
    }
}

