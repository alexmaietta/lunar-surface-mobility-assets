#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "pr_concept"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "pr_concept"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 1.8)
            float3 physics:diagonalInertia = (6730.1436, 21285.572, 21285.572)
            float physics:mass = 5973.5
            custom string propellant:source = "concept: no crew, consumables or payload"
        }
    }
}

