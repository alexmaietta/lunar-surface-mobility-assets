#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "pr_concept"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./robot.usda@
    ]
    upAxis = "Z"
)

def Xform "pr_concept" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./pr_concept.usda@
        string name = "pr_concept"
        string version = "0.1.1"
    }
    doc = "Generic modern two-crew pressurised rover concept (about 9 t, 7.0 m long, 3.3 m wide over the tyres, 3.3 m to the roof and 4.1 m to the dish): a smooth white composite pressure cabin with a raked nose and a wrap-around amber window band, carried on a grey chassis keel with dust skirts over six 1.1 m airless wheels. Every wheel sits on active double-wishbone suspension and steers (+/-45 deg, crab and turn-in-place). Two suitports on the aft bulkhead with top-hinged hatch joints (or, in the Ports=airlock variant, a walk-in airlock door), a grated aft porch with handrails, an IDSS-style docking ring with a hinged hatch on the left flank, flank radiators, two roof solar wings that hinge up from stowed flat to vertical, a gimballed 0.75 m dish, a pan-tilt navigation mast, eight brow and bumper lamps plus work and porch lights, and a 2.6 m five-joint robotic arm on the aft bulkhead."
    kind = "component"
)
{
    float3[] extentsHint = [(-4.0005, -1.7639999, -0.007621646), (3.553, 1.7635, 4.301294), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (-2.9535, -1.6558074, -0.007621646), (3.3035, 1.6553074, 3.302)]
