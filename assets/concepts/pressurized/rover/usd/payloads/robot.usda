#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "pr_concept"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "pr_concept" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "Generic Pressurised Rover (concept)"
    token isaac:license = "Other"
    string isaac:namespace = "pr_concept"
    prepend rel isaac:physics:robotJoints = [
