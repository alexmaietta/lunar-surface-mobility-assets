    token isaac:robotType = "Wheeled"
    string isaac:source = "lunar-surface-mobility-assets pipeline"
    string isaac:version = "0.1.1"

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "airlock_door" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "airlock_door" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Walk-in airlock door (1.0 x 1.5 m), Ports=airlock"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "arm_yaw" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "arm_shoulder" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "arm_elbow" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "arm_wrist_pitch" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "arm_wrist_roll" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "arm_tool_point" (
                                    prepend apiSchemas = ["IsaacSiteAPI"]
                                )
                                {
                                    string isaac:Description = "End-effector tool centre point (+Z = approach)"
                                    uniform token isaac:forwardAxis = "Z"
                                }
                            }
                        }
                    }
                }
            }

            over "dock_hatch" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

