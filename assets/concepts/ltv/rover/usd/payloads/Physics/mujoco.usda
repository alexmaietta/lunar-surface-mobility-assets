#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "ltv_concept"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "ltv_concept"
{
    over "Physics"
    {
        over "arm_yaw" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "arm_yaw_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -5250, -525, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 350
            uniform double mjc:forceRange:min = -350
            uniform double[] mjc:gainPrm = [5250, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </ltv_concept/Physics/arm_yaw>
        }

        over "arm_shoulder" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
