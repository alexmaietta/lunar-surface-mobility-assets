#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "ltv_concept"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "ltv_concept"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0.2, 0, 0.95)
            float3 physics:diagonalInertia = (580.6177, 2507.3933, 2944.845)
            float physics:mass = 2386.1
            custom string propellant:source = "NASA LTV: + up to 1,600 kg uncrewed payload, reduced speed"
        }
    }
}

