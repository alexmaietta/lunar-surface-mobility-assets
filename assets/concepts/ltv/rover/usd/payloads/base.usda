def Xform "ltv_concept" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./ltv_concept.usda@
        string name = "ltv_concept"
        string version = "0.1.1"
    }
    doc = "Generic Artemis-class Lunar Terrain Vehicle built from the common features of the 2020s LTV designs: four airless spring-tyre wheels on double-wishbone active suspension with coilover struts, independent steering and hub-motor drive on every corner, a battery/avionics tub with deck radiators, two seated crew stations with a hand controller (or an uncrewed cargo pallet), a tilting rear solar array, a pan-tilt navigation mast, a gimballed high-gain antenna, front hazard cameras, side boarding steps, eight named lamps and a five-axis robotic arm. Payload states follow the NASA LTV requirement: 2 suited crew (550 kg) + 250 kg cargo, or 1,600 kg uncrewed."
    kind = "component"
)
{
    float3[] extentsHint = [(-1.9624001, -1.3844, -0.0073074996), (1.921, 1.3836, 2.3551998), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (-1.8039999, -1.3573879, -0.0073074996), (1.8039999, 1.3565879, 1.7716378)]
