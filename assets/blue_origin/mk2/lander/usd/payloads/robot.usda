#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mk2"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mk2" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "Blue Moon MK2"
    token isaac:license = "Other"
    string isaac:namespace = "mk2"
    prepend rel isaac:physics:robotJoints = [
        </mk2/Physics/be7_0_gimbal_x>,
        </mk2/Physics/be7_0>,
        </mk2/Physics/be7_1_gimbal_x>,
