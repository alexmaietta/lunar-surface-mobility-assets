                over "be7_0" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "be7_0_exit" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "BE-7 dual-expander, 10,000 lbf, 20-100% throttle; MK2 uses three (Blue Origin). Positions estimated."
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "be7_1_gimbal_x" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
