    assetInfo = {
        asset identifier = @./mk2.usda@
        string name = "mk2"
        string version = "0.1.0"
    }
    doc = "Blue Origin Blue Moon Mark 2 crewed lunar lander (NASA Artemis Human Landing System), about 15.3 m tall and more than 45 t fuelled: a faceted white crew cabin at the base over a gold-MLI engine skirt with three gimballed BE-7 LOX/LH2 engines, a hinged crew door with an egress platform and deployable stair, a side IDSS-style docking port with a hinged hatch and two hooded windows; above it a triangulated truss cage around two oblate propellant tanks, and the MLI-wrapped LH2 tank inside four hinged sunshield panels under a white dome with a blue band, floodlights and two gimballed dish antennas. Four sprung legs with large dish footpads."
    kind = "component"
)
