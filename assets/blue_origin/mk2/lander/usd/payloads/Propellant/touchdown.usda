#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mk2"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mk2"
{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 7.2)
            float3 physics:diagonalInertia = (652725, 652725, 135000)
            float physics:mass = 30000
            custom string propellant:source = "estimate: dry + ascent propellant and reserves"
        }
    }
}

