#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mk2"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mk2"
{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 6.4)
            float3 physics:diagonalInertia = (348120, 348120, 72000)
            float physics:mass = 16000
            custom string propellant:source = "press: about 16 t dry"
        }
    }
}

