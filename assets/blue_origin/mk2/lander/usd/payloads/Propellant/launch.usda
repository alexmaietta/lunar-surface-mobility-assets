#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mk2"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mk2"
{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 8.2)
            float3 physics:diagonalInertia = (979087.5, 979087.5, 202500)
            float physics:mass = 45000
            custom string propellant:source = "Blue Origin / press: more than 45 t fuelled"
        }
    }
}

