{
    def Xform "base__aluminium" (
        prepend references = @./geometries.usd@</Geometries/base__aluminium>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "aluminium" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/aluminium>
            )
            {
            }
        }

        over "base__aluminium" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Instances/base__aluminium/VisualMaterials/aluminium>
        }
    }

