#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mk1"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "mk1"
{
    over "Geometry"
    {
        over "body" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0, 0, 4.1)
            float3 physics:diagonalInertia = (38341.332, 38341.332, 15800)
            float physics:mass = 7900
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "be7_gimbal_x" (
