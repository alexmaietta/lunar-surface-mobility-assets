#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mk1"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "mk1"
{
    over "Physics"
    {
        over "be7_gimbal_x" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "be7_gimbal_x_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -20000, -400, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 4000
            uniform double mjc:forceRange:min = -4000
            uniform double[] mjc:gainPrm = [20000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </mk1/Physics/be7_gimbal_x>
        }

        over "be7" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "be7_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -20000, -400, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 4000
            uniform double mjc:forceRange:min = -4000
            uniform double[] mjc:gainPrm = [20000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </mk1/Physics/be7>
        }

        over "hga_azimuth" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "hga_azimuth_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -50, -5, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 20
            uniform double mjc:forceRange:min = -20
            uniform double[] mjc:gainPrm = [50, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </mk1/Physics/hga_azimuth>
        }

        over "hga_elevation" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "hga_elevation_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -50, -5, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 20
            uniform double mjc:forceRange:min = -20
            uniform double[] mjc:gainPrm = [50, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </mk1/Physics/hga_elevation>
        }

        over "leg_0_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_1_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_2_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "leg_3_piston" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "solar_array_0" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "solar_array_0_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -500, -50, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 400
            uniform double mjc:forceRange:min = -400
            uniform double[] mjc:gainPrm = [500, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </mk1/Physics/solar_array_0>
        }

        over "solar_array_1" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "solar_array_1_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -500, -50, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 400
            uniform double mjc:forceRange:min = -400
            uniform double[] mjc:gainPrm = [500, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </mk1/Physics/solar_array_1>
        }
    }
}

