#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "nozzle_ext" (
        prepend apiSchemas = ["ColorSpaceAPI"]
    )
    {
        uniform token colorSpace:name = "lin_rec709_scene"
        token outputs:surface.connect = </Materials/nozzle_ext/Principled_BSDF.outputs:surface>

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            color3f inputs:diffuseColor.connect = </Materials/nozzle_ext/Image_Texture.outputs:rgb>
            float inputs:ior = 1.5
            float inputs:metallic.connect = </Materials/nozzle_ext/Image_Texture_002.outputs:r>
            normal3f inputs:normal.connect = </Materials/nozzle_ext/Image_Texture_003.outputs:rgb>
            float inputs:opacity = 1
            float inputs:roughness.connect = </Materials/nozzle_ext/Image_Texture_001.outputs:r>
            float inputs:specular = 0.5
            token outputs:surface
        }

        def Shader "Image_Texture" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "srgb_rec709_display"
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./Textures/nozzle_ext_basecolor.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </Materials/nozzle_ext/UV_Map.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "UV_Map"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "Image_Texture_002" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "data"
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./Textures/nozzle_ext_metallic.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Materials/nozzle_ext/UV_Map.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:r
        }

        def Shader "Image_Texture_001" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "data"
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./Textures/nozzle_ext_roughness.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Materials/nozzle_ext/UV_Map.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:r
        }

        def Shader "Image_Texture_003" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "data"
            uniform token info:id = "UsdUVTexture"
            float4 inputs:bias = (-1, -1, -1, -1)
            asset inputs:file = @./Textures/nozzle_ext_normal.png@
            float4 inputs:scale = (2, 2, 2, 2)
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Materials/nozzle_ext/UV_Map.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }
    }

