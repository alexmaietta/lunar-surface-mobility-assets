#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mk1"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mk1"
{
    over "Geometry"
    {
        over "body"
        {
            point3f physics:centerOfMass = (0, 0, 4.3)
            float3 physics:diagonalInertia = (33973.332, 33973.332, 14000)
            float physics:mass = 7000
            custom string propellant:source = "estimate"
        }
    }
}

