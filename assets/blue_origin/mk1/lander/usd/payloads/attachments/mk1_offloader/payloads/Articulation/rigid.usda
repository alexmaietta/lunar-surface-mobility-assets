#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mk1_offloader"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mk1_offloader"
{
    over "Geometry"
    {
        over "base"
        {
            over "crane_slew" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                over "crane_luff" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    over "crane_hoist" (
                        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "crane_slew" (
            active = false
        )
        {
        }

        over "crane_slew_actuator" (
            active = false
        )
        {
        }

        over "crane_luff" (
            active = false
        )
        {
        }

        over "crane_luff_actuator" (
            active = false
        )
        {
        }

        over "crane_hoist" (
            active = false
        )
        {
        }

        over "crane_hoist_actuator" (
            active = false
        )
        {
        }
    }
}

