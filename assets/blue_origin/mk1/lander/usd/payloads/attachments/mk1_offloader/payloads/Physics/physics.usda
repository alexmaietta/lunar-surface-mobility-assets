#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mk1_offloader"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "mk1_offloader"
{
    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0, 0, 0.05375)
            float3 physics:diagonalInertia = (0.19077966, 0.19077966, 0.36844906)
            float physics:mass = 6
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "crane_slew" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0.38909882, 0.00024999678, 0.56025)
                float3 physics:diagonalInertia = (2.8136437, 3.6088533, 2.6087284)
                float physics:mass = 18
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "crane_luff" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (1.9047999, 0, -0.03129997)
                    float3 physics:diagonalInertia = (2.0684428, 63.480408, 64.46958)
                    float physics:mass = 30
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "crane_hoist" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        point3f physics:centerOfMass = (0, 0, -0.31075)
                        float3 physics:diagonalInertia = (0.35074964, 0.35074973, 0.31024915)
                        float physics:mass = 6
                        quatf physics:principalAxes = (1, 0, 0, 0)
                    }
                }
            }
        }
    }

    def "Physics"
    {
        def PhysicsRevoluteJoint "crane_slew" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 43.633232
            float drive:angular:physics:maxForce = 2000
            float drive:angular:physics:stiffness = 104.71976
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "position"
            custom uniform token joint:role = "crane"
            uniform token physics:axis = "X"
            rel physics:body0 = </mk1_offloader/Geometry/base>
            rel physics:body1 = </mk1_offloader/Geometry/base/crane_slew>
            point3f physics:localPos0 = (0, 0, 0.11)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
            quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
            float physics:lowerLimit = -180
            float physics:upperLimit = 180
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "crane_luff" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 78.53982
            float drive:angular:physics:maxForce = 5000
            float drive:angular:physics:stiffness = 349.06586
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "position"
            custom uniform token joint:role = "crane"
            uniform token physics:axis = "X"
            rel physics:body0 = </mk1_offloader/Geometry/base/crane_slew>
            rel physics:body1 = </mk1_offloader/Geometry/base/crane_slew/crane_luff>
            point3f physics:localPos0 = (0, 0, 1.0699999)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float physics:lowerLimit = -30
            float physics:upperLimit = 60
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsPrismaticJoint "crane_hoist" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 500
            float drive:linear:physics:maxForce = 6000
            float drive:linear:physics:stiffness = 5000
            float drive:linear:physics:targetPosition = 0
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            custom uniform token joint:driveKind = "position"
            custom uniform token joint:role = "crane"
            uniform token physics:axis = "X"
            rel physics:body0 = </mk1_offloader/Geometry/base/crane_slew/crane_luff>
            rel physics:body1 = </mk1_offloader/Geometry/base/crane_slew/crane_luff/crane_hoist>
            point3f physics:localPos0 = (4.3199997, 0, -0.26)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, -0, 0.70710677, 0)
            quatf physics:localRot1 = (0.70710677, -0, 0.70710677, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 9
            float state:linear:physics:position = 0
            float state:linear:physics:velocity = 0
        }
    }
}

