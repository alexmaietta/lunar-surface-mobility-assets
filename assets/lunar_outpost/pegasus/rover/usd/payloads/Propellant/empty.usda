#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "pegasus"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "pegasus"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 0.65)
            float3 physics:diagonalInertia = (213.28125, 869.53125, 951.5625)
            float physics:mass = 787.5
            custom string propellant:source = "press: about 1 t"
        }
    }
}

