#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "pegasus"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "pegasus"
{
    over "Physics"
    {
        over "fl_lower_arm" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "fl_upright" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "fl_steer" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_steer_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -10000, -1000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 750
            uniform double mjc:forceRange:min = -750
            uniform double[] mjc:gainPrm = [10000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </pegasus/Physics/fl_steer>
        }

        over "fl_wheel" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_wheel_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -1500, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 199.875
            uniform double mjc:forceRange:min = -199.875
            uniform double[] mjc:gainPrm = [1500, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </pegasus/Physics/fl_wheel>
        }

        over "fl_strut" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "fl_strut_rod" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "fl_upper_arm" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

