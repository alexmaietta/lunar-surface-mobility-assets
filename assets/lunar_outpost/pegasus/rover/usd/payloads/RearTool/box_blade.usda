#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "pegasus"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "pegasus"
{
    def "Geometry"
    {
        def "chassis"
        {
            def Xform "box_blade" (
                delete apiSchemas = ["IsaacRobotAPI"]
                kind = "subcomponent"
                prepend references = @../attachments/box_blade/box_blade.usda@
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (-1.7, 0, 0.58)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "Geometry"
                {
                    over "base" (
                        delete apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysxArticulationAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    def "Physics"
    {
        def PhysicsFixedJoint "box_blade_mount"
        {
            rel physics:body0 = </pegasus/Geometry/chassis>
            rel physics:body1 = </pegasus/Geometry/chassis/box_blade/Geometry/base>
            point3f physics:localPos0 = (-1.7, 0, 0.58)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

