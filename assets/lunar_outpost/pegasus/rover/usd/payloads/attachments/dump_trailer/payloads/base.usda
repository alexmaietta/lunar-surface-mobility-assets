def Xform "dump_trailer" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./dump_trailer.usda@
        string name = "dump_trailer"
        string version = "0.3.0"
    }
    doc = "Two-wheel tipping dump trailer for Lunar Terrain Vehicle-class rovers, the hauler in a dig-haul-dump cycle (loader bucket or drum excavator fills it, the rover tows it to the berm or pad, the bed tips to dump). A passive yaw-and-pitch hitch and drawbar pull an axle frame on two free-rolling 0.70 m spring-mesh wheels. The 1.6 x 1.4 m bed holds about 0.8 m3 (1.2 t of loose regolith) and tips up to 55 degrees about its rear hinge on an electric ram."
    kind = "component"
)
