#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "base__anodised_grey" (
        prepend references = @./geometries.usd@</Geometries/base__anodised_grey>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "anodised_grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/anodised_grey>
            )
            {
            }
        }

        over "base__anodised_grey" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Instances/base__anodised_grey/VisualMaterials/anodised_grey>
        }
    }

