        asset identifier = @./box_blade.usda@
        string name = "box_blade"
        string version = "0.3.0"
    }
    doc = "Rear-mounted box blade for Lunar Terrain Vehicle-class rovers, the finishing tool for landing-pad foundations and roads. Towed forward, the main blade cuts high spots and carries the spoil inside the box, dropping it into low spots so repeated passes level a pad to grade. A row of scarifier teeth on a prismatic slide drops ahead of the blade to break up a crust. The 2.4 m width covers the rover's track so each pass grades the wheel ruts."
    kind = "component"
)
