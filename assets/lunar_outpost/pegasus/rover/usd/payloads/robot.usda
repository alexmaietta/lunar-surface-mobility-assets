                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "rr_contact" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                                string isaac:Description = "Nominal tyre contact point"
                                uniform token isaac:forwardAxis = "Z"
                            }

                            over "rr_hub" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                                string isaac:Description = "Wheel centre; +Z = outboard axle"
                                uniform token isaac:forwardAxis = "Z"
                            }
                        }
                    }
                }
            }

            over "rr_strut" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rr_strut_rod" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "rr_upper_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "solar_wing_l" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "solar_wing_l_normal" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Solar array centre; +Z = cell normal"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "solar_wing_r" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "solar_wing_r_normal" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Solar array centre; +Z = cell normal"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "crew_0_seat" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Crew seat reference point (H-point)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "crew_1_seat" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Crew seat reference point (H-point)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "hand_controller" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Hand controller grip (drive/steer)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "headlight_l" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "headlight_r" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "work_light_l" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "work_light_r" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "cargo_box_lid" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Front cargo box under hood"
                uniform token isaac:forwardAxis = "Z"
            }

            over "rear_box_top" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Rear shell roof"
                uniform token isaac:forwardAxis = "Z"
            }

            over "tow_hitch" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Rear tow hitch"
                uniform token isaac:forwardAxis = "Z"
            }

            over "vehicle_origin" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Ground point under the chassis centre at nominal ride height"
                uniform token isaac:forwardAxis = "Z"
            }

            over "imu" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IMU / navigation reference (estimated)"
                uniform token isaac:forwardAxis = "Z"
            }
        }
    }

    over "Physics"
    {
        over "fl_lower_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [0]
        }

        over "fl_upright" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [0]
        }

        over "fl_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
