#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "roller_compactor"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "roller_compactor"
{
    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (-0.045499995, 0, 0.001199998)
            float3 physics:diagonalInertia = (0.21805334, 0.09918084, 0.15748057)
            float physics:mass = 10
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "hitch_yaw" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (1.8626451e-9, 0, 0)
                float3 physics:diagonalInertia = (0.009857706, 0.009857706, 0.009857706)
                float physics:mass = 4
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "hitch_pitch" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (-0.95159996, -0.100000024, -0.0079)
                    float3 physics:diagonalInertia = (38.208584, 29.826181, 58.85386)
                    float physics:mass = 80
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "roller" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        point3f physics:centerOfMass = (0, 0, 0)
                        float3 physics:diagonalInertia = (41.60013, 8.733134, 41.60013)
                        float physics:mass = 120
                        quatf physics:principalAxes = (1, 0, 0, 0)
                    }
                }
            }
        }
    }

    def "Physics"
    {
        def PhysicsRevoluteJoint "hitch_yaw" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.08726646
            float drive:angular:physics:maxForce = 1000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "none"
            custom uniform token joint:role = "hitch"
            uniform token physics:axis = "X"
            rel physics:body0 = </roller_compactor/Geometry/base>
            rel physics:body1 = </roller_compactor/Geometry/base/hitch_yaw>
            point3f physics:localPos0 = (-0.12, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
            quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
            float physics:lowerLimit = -75
            float physics:upperLimit = 75
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "hitch_pitch" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.08726646
            float drive:angular:physics:maxForce = 1000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "none"
            custom uniform token joint:role = "hitch"
            uniform token physics:axis = "X"
            rel physics:body0 = </roller_compactor/Geometry/base/hitch_yaw>
            rel physics:body1 = </roller_compactor/Geometry/base/hitch_yaw/hitch_pitch>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float physics:lowerLimit = -30
            float physics:upperLimit = 30
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "roller" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.034906585
            float drive:angular:physics:maxForce = 1000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom uniform token joint:driveKind = "none"
            custom uniform token joint:role = "roller"
            uniform token physics:axis = "X"
            rel physics:body0 = </roller_compactor/Geometry/base/hitch_yaw/hitch_pitch>
            rel physics:body1 = </roller_compactor/Geometry/base/hitch_yaw/hitch_pitch/roller>
            point3f physics:localPos0 = (-1.43, 0, -0.27)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }
}

