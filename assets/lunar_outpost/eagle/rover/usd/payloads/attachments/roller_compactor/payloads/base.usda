def Xform "roller_compactor" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./roller_compactor.usda@
        string name = "roller_compactor"
        string version = "0.3.0"
    }
    doc = "Towed smooth-drum vibratory roller for Lunar Terrain Vehicle-class rovers, after the compactor developed by Michigan Tech for the Lunar Outpost / Colorado School of Mines ASPECT site-preparation rover. A passive yaw-and-pitch hitch and A-frame drawbar pull a 1.8 m drum carried in a yoke with an eccentric-mass vibrator at one end. A hopper on the yoke can be filled with regolith ballast, since a rover cannot afford to launch a heavy roller. Use for compacting landing-pad foundations (NASA's Lunar Innovation Park plan calls for 80 % relative density) and berms."
    kind = "component"
)
{
    float3[] extentsHint = [(-2.0444, -1.2228, -0.60040003), (0.0306, 1.0228, 0.407), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (-2.0444, -0.986802, -0.60040003), (-0.14341567, 0.986402, 0.407)]
