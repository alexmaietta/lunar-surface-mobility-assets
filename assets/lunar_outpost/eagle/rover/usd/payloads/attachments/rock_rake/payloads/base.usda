#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "rock_rake"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./robot.usda@
    ]
    upAxis = "Z"
)

def Xform "rock_rake" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./rock_rake.usda@
        string name = "rock_rake"
        string version = "0.3.0"
    }
    doc = "Front rock rake for Lunar Terrain Vehicle-class rovers, after the rock and regolith grader on the Colorado School of Mines / Lunar Outpost ASPECT rover and the rock clearing done with NASA's LANCE blade. Seventeen curved steel tines on a 2.5 m toolbar sift cobbles and boulders out of the top layer and roll them into a windrow while fine regolith passes between the tines, clearing a landing-pad or road site before grading."
    kind = "component"
)
{
    float3[] extentsHint = [(-0.0306, -1.2524, -0.535376), (1.08156, 1.2524, 0.1912), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (0.07625187, -1.2524, -0.535376), (1.08156, 1.2524, 0.041593764)]
    token[] semantics:labels:class = ["construction_tool", "rock_rake"]

    def Scope "Geometry"
    {
        def Xform "base"
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
