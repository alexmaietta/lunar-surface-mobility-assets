#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mapp"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "mapp"
{
    over "Physics"
    {
        over "rocker_l" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "fl_wheel" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_wheel_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -15, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 0.2803125
            uniform double mjc:forceRange:min = -0.2803125
            uniform double[] mjc:gainPrm = [15, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </mapp/Physics/fl_wheel>
        }

        over "rl_wheel" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "rl_wheel_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -15, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 0.2803125
            uniform double mjc:forceRange:min = -0.2803125
            uniform double[] mjc:gainPrm = [15, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </mapp/Physics/rl_wheel>
        }

        over "rocker_r" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "fr_wheel" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fr_wheel_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -15, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 0.2803125
            uniform double mjc:forceRange:min = -0.2803125
            uniform double[] mjc:gainPrm = [15, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </mapp/Physics/fr_wheel>
        }

        over "rr_wheel" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "rr_wheel_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -15, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 0.2803125
            uniform double mjc:forceRange:min = -0.2803125
            uniform double[] mjc:gainPrm = [15, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </mapp/Physics/rr_wheel>
        }
    }
}

