#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mapp"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mapp"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 0.15)
            float3 physics:diagonalInertia = (0.056225, 0.085345, 0.104)
            float physics:mass = 7.8
            custom string propellant:source = "Lunar Outpost: 5-10 kg (10 kg used)"
        }
    }
}

