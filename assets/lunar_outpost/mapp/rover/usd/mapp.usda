    defaultPrim = "mapp"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "mapp" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Antennas = "flight"
        string Articulation = "articulated"
        string Fidelity = "full"
        string Payload = "flight"
        string Physics = "physx"
    }
    prepend variantSets = ["Articulation", "Payload", "Antennas", "Fidelity", "Physics"]
)
{
    variantSet "Articulation" = {
        "articulated" (
            prepend payload = @./payloads/Articulation/articulated.usda@
        ) {

