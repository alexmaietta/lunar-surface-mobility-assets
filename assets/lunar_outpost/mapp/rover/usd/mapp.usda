            prepend payload = @./payloads/Articulation/rigid.usda@
        ) {

        }
    }
    variantSet "Payload" = {
        "flight" (
            prepend payload = @./payloads/Propellant/flight.usda@
        ) {

        }
        "none" {

        }
    }
    variantSet "Antennas" = {
        "field_test" (
            prepend payload = @./payloads/Antennas/field_test.usda@
        ) {

        }
        "flight" (
            prepend payload = @./payloads/Antennas/flight.usda@
        ) {

        }
    }
    variantSet "Fidelity" = {
        "full" (
            prepend payload = @./payloads/Fidelity/full.usda@
        ) {

        }
        "none" {

        }
        "proxy" (
            prepend payload = @./payloads/Fidelity/proxy.usd@
        ) {

        }
        "simple" (
            prepend payload = @./payloads/Fidelity/simple.usd@
        ) {

        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
