    <origin xyz="0.165 0 0.19" rpy="0 -0.135393 0"/>
  </joint>
  <link name="imu_frame"/>
  <joint name="imu_frame_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_frame"/>
    <origin xyz="0 0 0.15" rpy="0 -1.5708 0"/>
  </joint>
</robot>
