    </visual>
    <collision name="rl_wheel_tyre_col">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/rl_wheel_tyre_col.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="rl_wheel" type="continuous">
