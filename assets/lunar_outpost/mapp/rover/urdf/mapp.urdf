    <child link="rl_wheel"/>
    <origin xyz="-0.145 0.025 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.280313" velocity="6.28319"/>
    <dynamics damping="15" friction="0"/>
  </joint>
  <link name="fr_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.00072509" ixy="0" ixz="0" iyy="0.000928267" iyz="0" izz="0.00072509"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/fr_wheel.obj"/>
      </geometry>
    </visual>
    <collision name="fr_wheel_tyre_col">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/fr_wheel_tyre_col.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="fr_wheel" type="continuous">
    <parent link="rocker_r"/>
    <child link="fr_wheel"/>
    <origin xyz="0.145 -0.025 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.280313" velocity="6.28319"/>
    <dynamics damping="15" friction="0"/>
  </joint>
  <link name="rr_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.00070949" ixy="0" ixz="0" iyy="0.000897067" iyz="0" izz="0.000709491"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/rr_wheel.obj"/>
