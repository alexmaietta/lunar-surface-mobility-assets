#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "cadre"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "cadre" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "NASA JPL CADRE rover"
    token isaac:license = "Other"
    string isaac:namespace = "cadre"
    prepend rel isaac:physics:robotJoints = [
        </cadre/Physics/fl_wheel>,
        </cadre/Physics/fr_wheel>,
        </cadre/Physics/front_camera_cover>,
        </cadre/Physics/rear_camera_cover>,
        </cadre/Physics/rl_wheel>,
        </cadre/Physics/rr_wheel>,
        </cadre/Physics/solar_wing_l>,
        </cadre/Physics/solar_wing_r>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </cadre/Geometry/chassis>,
        </cadre/Geometry/chassis/tether_point>,
        </cadre/Geometry/chassis/gpr_phase_centre>,
        </cadre/Geometry/chassis/vehicle_origin>,
        </cadre/Geometry/chassis/imu>,
        </cadre/Geometry/chassis/fl_wheel>,
        </cadre/Geometry/chassis/fl_wheel/fl_contact>,
        </cadre/Geometry/chassis/fl_wheel/fl_hub>,
        </cadre/Geometry/chassis/fr_wheel>,
        </cadre/Geometry/chassis/fr_wheel/fr_contact>,
        </cadre/Geometry/chassis/fr_wheel/fr_hub>,
        </cadre/Geometry/chassis/front_camera_cover>,
        </cadre/Geometry/chassis/rear_camera_cover>,
        </cadre/Geometry/chassis/rl_wheel>,
        </cadre/Geometry/chassis/rl_wheel/rl_contact>,
        </cadre/Geometry/chassis/rl_wheel/rl_hub>,
        </cadre/Geometry/chassis/rr_wheel>,
        </cadre/Geometry/chassis/rr_wheel/rr_contact>,
        </cadre/Geometry/chassis/rr_wheel/rr_hub>,
        </cadre/Geometry/chassis/solar_wing_l>,
        </cadre/Geometry/chassis/solar_wing_r>,
    ]
    token isaac:robotType = "Wheeled"
    string isaac:source = "lunar-surface-mobility-assets pipeline"
    string isaac:version = "0.1.0"

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "fl_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fl_contact" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Nominal tyre contact point"
                    uniform token isaac:forwardAxis = "Z"
                }

                over "fl_hub" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Wheel centre; +Z = outboard axle"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "fr_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fr_contact" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Nominal tyre contact point"
                    uniform token isaac:forwardAxis = "Z"
                }

                over "fr_hub" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Wheel centre; +Z = outboard axle"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "front_camera_cover" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rear_camera_cover" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rl_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rl_contact" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Nominal tyre contact point"
                    uniform token isaac:forwardAxis = "Z"
                }

                over "rl_hub" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Wheel centre; +Z = outboard axle"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "rr_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rr_contact" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Nominal tyre contact point"
                    uniform token isaac:forwardAxis = "Z"
                }

                over "rr_hub" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Wheel centre; +Z = outboard axle"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "solar_wing_l" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "solar_wing_r" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "tether_point" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Deployer tether attach (lowered ~1.2 m from IM-3)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "gpr_phase_centre" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Ground-penetrating radar antenna"
                uniform token isaac:forwardAxis = "Z"
            }

            over "vehicle_origin" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Ground point under the chassis centre at nominal ride height"
                uniform token isaac:forwardAxis = "Z"
            }

            over "imu" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IMU / navigation reference (estimated)"
                uniform token isaac:forwardAxis = "Z"
            }
        }
    }

    over "Physics"
    {
        over "fl_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fr_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "front_camera_cover" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rear_camera_cover" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rl_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rr_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "solar_wing_l" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "solar_wing_r" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }
    }
}

