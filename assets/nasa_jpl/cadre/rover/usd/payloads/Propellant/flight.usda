#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "cadre"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "cadre"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 0.16)
            float3 physics:diagonalInertia = (0.0979575, 0.18644284, 0.26745632)
            float physics:mass = 7.06
            custom string propellant:source = "JPL fact sheet: 8.6 kg"
        }
    }
}

