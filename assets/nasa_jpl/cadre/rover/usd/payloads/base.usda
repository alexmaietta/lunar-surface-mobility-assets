        asset identifier = @./cadre.usda@
        string name = "cadre"
        string version = "0.1.0"
    }
    doc = "One of the three NASA JPL CADRE (Cooperative Autonomous Distributed Robotic Exploration) suitcase-sized rovers for Intuitive Machines IM-3: 0.546 x 0.385 x 0.235 m and 8.6 kg, a silver-MLI deck over an amber thermally controlled housing and a ground-penetrating-radar antenna, two solar wings hinged on the long sides (folded on the deck when stowed), GPR sync and comm antennas, a sun sensor, front and rear stereo cameras behind flip-up covers, and four 6-spoke grousered aluminium wheels with skid steering."
    kind = "component"
)
