#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "cadre"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "cadre"
{
    over "Geometry"
    {
        over "chassis"
        {
            over "fl_wheel" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "fr_wheel" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "front_camera_cover" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "rear_camera_cover" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "rl_wheel" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "rr_wheel" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "solar_wing_l" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }

            over "solar_wing_r" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "fl_wheel" (
            active = false
        )
        {
        }

        over "fl_wheel_actuator" (
            active = false
        )
        {
        }

        over "fr_wheel" (
            active = false
        )
        {
        }

        over "fr_wheel_actuator" (
            active = false
        )
        {
        }

        over "front_camera_cover" (
            active = false
        )
        {
        }

        over "front_camera_cover_actuator" (
            active = false
        )
        {
        }

        over "rear_camera_cover" (
            active = false
        )
        {
        }

        over "rear_camera_cover_actuator" (
            active = false
        )
        {
        }

        over "rl_wheel" (
            active = false
        )
        {
        }

        over "rl_wheel_actuator" (
            active = false
        )
        {
        }

        over "rr_wheel" (
            active = false
        )
        {
        }

        over "rr_wheel_actuator" (
            active = false
        )
        {
        }

        over "solar_wing_l" (
            active = false
        )
        {
        }

        over "solar_wing_l_actuator" (
            active = false
        )
        {
        }

        over "solar_wing_r" (
            active = false
        )
        {
        }

        over "solar_wing_r_actuator" (
            active = false
        )
        {
        }
    }
}

