def Xform "promise" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./promise.usda@
        string name = "promise"
        string version = "0.3.0"
    }
    doc = "NASA / JPL PROMISE (Polar Rover for Observation, Mapping, and In-Situ Exploration), November 2026 announcement: the Curiosity vehicle-system test bed reflown to the lunar south pole on Blue Moon MK1, about 1,000 kg. A white warm-electronics box on Curiosity's six-wheel rocker-bogie with a deck differential bar, four steering corner wheels and 50 cm aluminium chevron-grouser wheels with curved titanium spokes. No arm: the VIPER-heritage TRIDENT 1 m drill rides a tower on the front-left corner. A flight-spare MMRTG sits at the rear between two heat exchangers with gold tubing, the remote-sensing mast carries the Lunar Dashcam stereo pairs, and blue LED panels light the body. Suspension pivots follow the JPL Mars 2020 kinematic layout (the shared Curiosity mobility design); deck equipment, comms and instrument placement are estimated from NASA's render."
    kind = "component"
)
