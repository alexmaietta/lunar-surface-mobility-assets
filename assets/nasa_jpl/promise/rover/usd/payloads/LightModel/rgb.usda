#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "promise"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "promise"
{
    over "Geometry"
    {
        over "chassis"
        {
            over "haz_light_front_l"
            {
                over "emitter"
                {
                    float photometric:power = 15859.016
                }
            }

            over "haz_light_side_l"
            {
                over "emitter"
                {
                    float photometric:power = 15859.016
                }
            }

            over "haz_light_rear_l"
            {
                over "emitter"
                {
                    float photometric:power = 15859.016
                }
            }

            over "haz_light_front_r"
            {
                over "emitter"
                {
                    float photometric:power = 15859.016
                }
            }

            over "haz_light_side_r"
            {
                over "emitter"
                {
                    float photometric:power = 15859.016
                }
            }

            over "haz_light_rear_r"
            {
                over "emitter"
                {
                    float photometric:power = 15859.016
                }
            }
        }
    }
}

