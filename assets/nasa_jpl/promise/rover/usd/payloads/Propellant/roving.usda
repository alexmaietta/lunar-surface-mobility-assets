#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "promise"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "promise"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 0.85)
            float3 physics:diagonalInertia = (151.56917, 215.35167, 332.62918)
            float physics:mass = 823
            custom string propellant:source = "Planetary Society estimate, about 1,000 kg (NASA has not published a mass)"
        }
    }
}

