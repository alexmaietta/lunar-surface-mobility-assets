        def MjcActuator "ml_wheel_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -1000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 81.24999999999999
            uniform double mjc:forceRange:min = -81.24999999999999
            uniform double[] mjc:gainPrm = [1000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </promise/Physics/ml_wheel>
