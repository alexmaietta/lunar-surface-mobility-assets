#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "clv1"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "clv1" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "Astrolab CLV-1"
    token isaac:license = "Other"
    string isaac:namespace = "clv1"
    prepend rel isaac:physics:robotJoints = [
        </clv1/Physics/fl_arm>,
        </clv1/Physics/fl_steer>,
        </clv1/Physics/fl_wheel>,
        </clv1/Physics/fr_arm>,
        </clv1/Physics/fr_steer>,
        </clv1/Physics/fr_wheel>,
        </clv1/Physics/hga_azimuth>,
        </clv1/Physics/hga_elevation>,
        </clv1/Physics/nav_mast_pan>,
        </clv1/Physics/nav_mast_tilt>,
        </clv1/Physics/rear_mast_pan>,
        </clv1/Physics/rear_mast_tilt>,
        </clv1/Physics/rl_arm>,
        </clv1/Physics/rl_steer>,
        </clv1/Physics/rl_wheel>,
        </clv1/Physics/rr_arm>,
        </clv1/Physics/rr_steer>,
        </clv1/Physics/rr_wheel>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </clv1/Geometry/chassis>,
        </clv1/Geometry/chassis/crew_0_seat>,
        </clv1/Geometry/chassis/crew_1_seat>,
        </clv1/Geometry/chassis/hand_controller>,
        </clv1/Geometry/chassis/head_lamp_r0>,
        </clv1/Geometry/chassis/head_lamp_r1>,
        </clv1/Geometry/chassis/head_lamp_r2>,
        </clv1/Geometry/chassis/head_lamp_l0>,
        </clv1/Geometry/chassis/head_lamp_l1>,
        </clv1/Geometry/chassis/head_lamp_l2>,
        </clv1/Geometry/chassis/roof_lamp_0>,
        </clv1/Geometry/chassis/roof_lamp_1>,
        </clv1/Geometry/chassis/roof_lamp_2>,
        </clv1/Geometry/chassis/roof_lamp_3>,
        </clv1/Geometry/chassis/tail_lamp_l>,
        </clv1/Geometry/chassis/tail_lamp_r>,
        </clv1/Geometry/chassis/cargo_lamp_l>,
        </clv1/Geometry/chassis/cargo_lamp_r>,
        </clv1/Geometry/chassis/cargo_rack>,
        </clv1/Geometry/chassis/front_payload>,
        </clv1/Geometry/chassis/roof_point>,
        </clv1/Geometry/chassis/vehicle_origin>,
        </clv1/Geometry/chassis/imu>,
        </clv1/Geometry/chassis/fl_arm>,
        </clv1/Geometry/chassis/fl_arm/fl_steer>,
        </clv1/Geometry/chassis/fl_arm/fl_steer/fl_wheel>,
        </clv1/Geometry/chassis/fl_arm/fl_steer/fl_wheel/fl_contact>,
        </clv1/Geometry/chassis/fl_arm/fl_steer/fl_wheel/fl_hub>,
        </clv1/Geometry/chassis/fr_arm>,
        </clv1/Geometry/chassis/fr_arm/fr_steer>,
        </clv1/Geometry/chassis/fr_arm/fr_steer/fr_wheel>,
        </clv1/Geometry/chassis/fr_arm/fr_steer/fr_wheel/fr_contact>,
        </clv1/Geometry/chassis/fr_arm/fr_steer/fr_wheel/fr_hub>,
        </clv1/Geometry/chassis/hga_azimuth>,
        </clv1/Geometry/chassis/hga_azimuth/hga_elevation>,
        </clv1/Geometry/chassis/hga_azimuth/hga_elevation/hga_boresight>,
        </clv1/Geometry/chassis/nav_mast_pan>,
        </clv1/Geometry/chassis/nav_mast_pan/nav_mast_tilt>,
        </clv1/Geometry/chassis/rear_mast_pan>,
        </clv1/Geometry/chassis/rear_mast_pan/rear_mast_tilt>,
        </clv1/Geometry/chassis/rl_arm>,
        </clv1/Geometry/chassis/rl_arm/rl_steer>,
        </clv1/Geometry/chassis/rl_arm/rl_steer/rl_wheel>,
        </clv1/Geometry/chassis/rl_arm/rl_steer/rl_wheel/rl_contact>,
        </clv1/Geometry/chassis/rl_arm/rl_steer/rl_wheel/rl_hub>,
        </clv1/Geometry/chassis/rr_arm>,
        </clv1/Geometry/chassis/rr_arm/rr_steer>,
        </clv1/Geometry/chassis/rr_arm/rr_steer/rr_wheel>,
        </clv1/Geometry/chassis/rr_arm/rr_steer/rr_wheel/rr_contact>,
        </clv1/Geometry/chassis/rr_arm/rr_steer/rr_wheel/rr_hub>,
    ]
    token isaac:robotType = "Wheeled"
    string isaac:source = "lunar-surface-mobility-assets pipeline"
    string isaac:version = "0.1.1"

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "fl_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fl_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fl_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fl_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "fl_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "fr_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fr_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fr_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fr_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "fr_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "hga_azimuth" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "hga_elevation" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "hga_boresight" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "High-gain antenna boresight (+Z), 2-axis gimbal"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "nav_mast_pan" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "nav_mast_tilt" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "rear_mast_pan" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rear_mast_tilt" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "rl_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rl_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "rl_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "rl_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "rl_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "rr_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rr_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "rr_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "rr_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "rr_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "crew_0_seat" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Crew seat reference point (H-point)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "crew_1_seat" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Crew seat reference point (H-point)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "hand_controller" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Hand controller grip (drive/steer)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "head_lamp_r0" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "head_lamp_r1" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "head_lamp_r2" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "head_lamp_l0" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "head_lamp_l1" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "head_lamp_l2" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "roof_lamp_0" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "roof_lamp_1" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "roof_lamp_2" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "roof_lamp_3" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "tail_lamp_l" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "tail_lamp_r" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "cargo_lamp_l" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "cargo_lamp_r" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "cargo_rack" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Rear open cargo rack"
                uniform token isaac:forwardAxis = "Z"
            }

            over "front_payload" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Crew deck / uncrewed cargo interface"
                uniform token isaac:forwardAxis = "Z"
            }

            over "roof_point" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Roll-cage lift point"
                uniform token isaac:forwardAxis = "Z"
            }

            over "vehicle_origin" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Ground point under the chassis centre at nominal ride height"
                uniform token isaac:forwardAxis = "Z"
            }

            over "imu" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IMU / navigation reference (estimated)"
                uniform token isaac:forwardAxis = "Z"
            }
        }
    }

    over "Physics"
    {
        over "fl_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fl_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fl_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fr_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fr_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fr_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "hga_azimuth" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "hga_elevation" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "nav_mast_pan" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "nav_mast_tilt" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rear_mast_pan" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rear_mast_tilt" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rl_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rl_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rl_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rr_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rr_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rr_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }
    }
}

