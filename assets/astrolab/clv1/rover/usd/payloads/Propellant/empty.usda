#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "clv1"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

