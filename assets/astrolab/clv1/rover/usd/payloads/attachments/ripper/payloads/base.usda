def Xform "ripper" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./ripper.usda@
        string name = "ripper"
        string version = "0.3.0"
    }
    doc = "Rear-mounted ripper for Lunar Terrain Vehicle-class rovers. Lunar regolith densifies quickly below the loose top few centimetres (about 1.3 g/cm3 at the surface to 1.85 g/cm3 by 30-60 cm), so a ripper loosens the dense layer before a blade, bucket or drum digs it. Three curved steel shanks with replaceable tips hang from a toolbar on a lifting frame and reach about 0.35 m below grade at full depth."
    kind = "component"
)
{
    float3[] extentsHint = [(-1.0216054, -0.8536, -0.52243793), (0.0306, 0.8536, 0.22127888), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (-1.0216054, -0.8536, -0.52243793), (-0.0688, 0.8536, 0.1017751)]
