                prepend references = @./materials.usda@</Materials/white_panel>
            )
            {
            }
        }

        over "base__white_panel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Instances/base__white_panel/VisualMaterials/white_panel>
        }
    }

    def Xform "base__anodised_dark" (
        prepend references = @./geometries.usd@</Geometries/base__anodised_dark>
    )
