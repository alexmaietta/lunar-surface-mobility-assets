            rel material:binding = </Instances/base__anodised_dark/VisualMaterials/anodised_dark>
        }
    }

    def Xform "base__steel" (
        prepend references = @./geometries.usd@</Geometries/base__steel>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "steel" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/steel>
            )
            {
            }
        }

        over "base__steel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Instances/base__steel/VisualMaterials/steel>
        }
    }

    def Xform "ripper_lift__white_panel" (
        prepend references = @./geometries.usd@</Geometries/ripper_lift__white_panel>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "white_panel" (
