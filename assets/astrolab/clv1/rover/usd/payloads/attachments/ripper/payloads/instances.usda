    def Xform "ripper_lift__steel" (
        prepend references = @./geometries.usd@</Geometries/ripper_lift__steel>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "steel" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/steel>
            )
            {
            }
        }

        over "ripper_lift__steel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Instances/ripper_lift__steel/VisualMaterials/steel>
