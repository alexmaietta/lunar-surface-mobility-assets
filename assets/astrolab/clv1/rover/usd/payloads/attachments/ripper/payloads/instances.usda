    def Xform "ripper_lift__anodised_grey" (
        prepend references = @./geometries.usd@</Geometries/ripper_lift__anodised_grey>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "anodised_grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/anodised_grey>
            )
            {
