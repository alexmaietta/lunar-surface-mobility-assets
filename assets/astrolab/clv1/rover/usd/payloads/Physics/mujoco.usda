#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "clv1"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "clv1"
{
    over "Physics"
    {
        over "fl_arm" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_arm_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -31839.84375, -1405.843028610858, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 4245.3125
            uniform double mjc:forceRange:min = -4245.3125
            uniform double[] mjc:gainPrm = [31839.84375, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </clv1/Physics/fl_arm>
        }

        over "fl_steer" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_steer_actuator"
        {
