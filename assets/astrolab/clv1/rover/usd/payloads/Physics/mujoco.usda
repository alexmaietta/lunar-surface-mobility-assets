            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 712.5
            uniform double mjc:forceRange:min = -712.5
            uniform double[] mjc:gainPrm = [9500, 0, 0, 0, 0, 0, 0, 0, 0, 0]
