def Xform "clv1" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Articulation = "articulated"
        string Crew = "crewed"
        string Fidelity = "full"
        string Lights = "on"
        string Payload = "empty"
        string Physics = "physx"
