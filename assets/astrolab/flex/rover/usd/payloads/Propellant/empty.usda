#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "flex"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "flex"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 1.1)
            float3 physics:diagonalInertia = (138.1375, 167.96875, 185.16875)
            float physics:mass = 322.5
            custom string propellant:source = "press: terrestrial prototype about 500 kg (1,100 lb)"
        }
    }
}

