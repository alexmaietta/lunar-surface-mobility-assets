#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "flex"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "flex"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (-0.45, 0, 1.3)
            float3 physics:diagonalInertia = (369.4375, 449.21875, 495.21875)
            float physics:mass = 862.5
            custom string propellant:source = "estimate: + 2 suited crew (2 x 220 kg) + 100 kg"
        }
    }
}

