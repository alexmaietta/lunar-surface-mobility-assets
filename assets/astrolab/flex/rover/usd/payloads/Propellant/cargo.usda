#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "flex"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "flex"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 1.05)
            float3 physics:diagonalInertia = (566.4708, 688.80206, 759.3354)
            float physics:mass = 1322.5
            custom string propellant:source = "Astrolab: up to 1,000 kg payload"
        }
    }
}

