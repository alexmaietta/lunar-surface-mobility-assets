#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "flex"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "flex"
{
    def "Geometry"
    {
        def "chassis"
        {
            def Xform "rock_rake" (
                delete apiSchemas = ["IsaacRobotAPI"]
                kind = "subcomponent"
                prepend references = @../attachments/rock_rake/rock_rake.usda@
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (1.14, 0, 0.6)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "Geometry"
                {
                    over "base" (
                        delete apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysxArticulationAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    def "Physics"
    {
        def PhysicsFixedJoint "rock_rake_mount"
        {
            rel physics:body0 = </flex/Geometry/chassis>
            rel physics:body1 = </flex/Geometry/chassis/rock_rake/Geometry/base>
            point3f physics:localPos0 = (1.14, 0, 0.6)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

