#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "flex"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "flex"
{
    over "Physics"
    {
        over "solar_array"
        {
            float drive:angular:physics:targetPosition = 90
            float state:angular:physics:position = 90
        }
    }
}

