def Xform "v_blade" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./v_blade.usda@
        string name = "v_blade"
        string version = "0.3.0"
    }
    doc = "Front-mounted hinged V-blade for Lunar Terrain Vehicle-class rovers, after terrestrial V-plows. Two 1.45 m curved composite wings pivot independently on a steel nose post at the end of a lifting push frame, so the blade works as a V (splits regolith to both sides, opens a track or trench line), straight (dozing), scoop or inverted V (carries a load), or angled left or right (casts a windrow to one side when building a berm line). The wings are modelled in a 25 degree V; each wing joint runs from a 25 degree scoop through straight to a 35 degree V."
    kind = "component"
)
