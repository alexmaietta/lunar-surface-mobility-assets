#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "box_blade"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "box_blade"
{
    over "Physics"
    {
        over "box_lift" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "box_lift_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -50000, -5000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 8000
            uniform double mjc:forceRange:min = -8000
            uniform double[] mjc:gainPrm = [50000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </box_blade/Physics/box_lift>
        }

        over "scarifier" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "scarifier_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -20000, -2000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 3000
            uniform double mjc:forceRange:min = -3000
            uniform double[] mjc:gainPrm = [20000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </box_blade/Physics/scarifier>
        }
    }
}

