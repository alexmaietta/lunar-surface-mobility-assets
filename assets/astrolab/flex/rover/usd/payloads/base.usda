def Xform "flex" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./flex.usda@
        string name = "flex"
        string version = "0.1.0"
    }
    doc = "Venturi Astrolab FLEX (Flexible Logistics and Exploration) full-scale terrestrial prototype, the basis of the CLV-1 Lunar Terrain Vehicle (3.35 x 2.50 m over tyres, wheelbase 2.7 m, track 2.1 m, deck rim 2.0 m, about 500 kg): an open U-frame with bronze trapezoid side walls inside white frames, a front avionics bay with a 4 x 3 drawer grid, an open underslung cargo bay, four active wheel-on-limb legs with belt-driven pivots, all-wheel and crab steering, hub motors and carbon fenders on 0.67 m airless tyres, two standing crew stations on a removable rear deck, a 2.4 m six-axis arm folded across the front, lamp pods on the four corner posts, a tall antenna mast and a hinged 3 m2 solar array that stows flat on the top deck and tilts up into a vertical tower."
    kind = "component"
)
