#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "flex"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "flex"
{
    over "Geometry"
    {
        over "chassis"
        {
            over "arm_yaw" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                over "arm_shoulder" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    over "arm_elbow" (
                        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        over "arm_wrist_pitch" (
                            delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                        )
                        {
                            over "arm_wrist_roll" (
                                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }

            over "fl_arm" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                over "fl_steer" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    over "fl_wheel" (
                        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
