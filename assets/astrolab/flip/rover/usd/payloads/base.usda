        asset identifier = @./flip.usda@
        string name = "flip"
        string version = "0.1.0"
    }
    doc = "Astrolab FLIP (FLEX Lunar Innovation Platform), flying on Astrobotic Griffin-1: a 480 kg uncrewed rover (about 2.35 x 1.9 x 2.3 m, wheelbase 1.4 m, track 1.58 m) with a low silver 1.6 x 0.7 x 0.4 m chassis, a vertical wedge tower over the front axle carrying solar cells and an antenna spike, a rear payload plate, and four 0.93 m Venturi hyper-deformable cable-spoke wheels on active corner swing arms with all-wheel steering. Geometry is measured from renders (no official dimensions)."
    kind = "component"
)
