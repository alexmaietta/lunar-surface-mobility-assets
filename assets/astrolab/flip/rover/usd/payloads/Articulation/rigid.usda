#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "flip"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "flip"
{
    over "Geometry"
    {
        over "chassis"
        {
            over "fl_arm" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
