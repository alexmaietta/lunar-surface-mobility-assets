#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "flip"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "flip"
{
    over "Physics"
    {
        over "fl_arm" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_arm_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -26324.999999999993, -743.4370450818278, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 3509.999999999999
            uniform double mjc:forceRange:min = -3509.999999999999
            uniform double[] mjc:gainPrm = [26324.999999999993, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </flip/Physics/fl_arm>
        }

        over "fl_steer" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_steer_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -4800, -480, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 360
            uniform double mjc:forceRange:min = -360
            uniform double[] mjc:gainPrm = [4800, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </flip/Physics/fl_steer>
        }

        over "fl_wheel" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "fl_wheel_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -720, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 108.81000000000002
            uniform double mjc:forceRange:min = -108.81000000000002
            uniform double[] mjc:gainPrm = [720, 0, 0, 0, 0, 0, 0, 0, 0, 0]
