#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "flip"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "flip"
{
    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0.12, 0, 0.62)
            float3 physics:diagonalInertia = (38.432335, 99.62843, 90.16817)
            float physics:mass = 354.76
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "fl_arm" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0.20193516, 0, 0.04420826)
