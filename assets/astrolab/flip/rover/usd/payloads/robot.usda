#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "flip"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "flip" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "Astrolab FLIP"
    token isaac:license = "Other"
    string isaac:namespace = "flip"
    prepend rel isaac:physics:robotJoints = [
        </flip/Physics/fl_arm>,
        </flip/Physics/fl_steer>,
        </flip/Physics/fl_wheel>,
        </flip/Physics/fr_arm>,
        </flip/Physics/fr_steer>,
        </flip/Physics/fr_wheel>,
        </flip/Physics/nav_mast_pan>,
        </flip/Physics/nav_mast_tilt>,
        </flip/Physics/rear_cam_pan>,
        </flip/Physics/rear_cam_tilt>,
        </flip/Physics/rl_arm>,
        </flip/Physics/rl_steer>,
        </flip/Physics/rl_wheel>,
        </flip/Physics/rr_arm>,
        </flip/Physics/rr_steer>,
        </flip/Physics/rr_wheel>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </flip/Geometry/chassis>,
        </flip/Geometry/chassis/head_lamp_l>,
        </flip/Geometry/chassis/head_lamp_r>,
        </flip/Geometry/chassis/rear_lamp_l>,
        </flip/Geometry/chassis/rear_lamp_r>,
        </flip/Geometry/chassis/payload_plate>,
        </flip/Geometry/chassis/lift_point>,
        </flip/Geometry/chassis/lidar>,
        </flip/Geometry/chassis/vehicle_origin>,
        </flip/Geometry/chassis/imu>,
        </flip/Geometry/chassis/fl_arm>,
        </flip/Geometry/chassis/fl_arm/fl_steer>,
        </flip/Geometry/chassis/fl_arm/fl_steer/fl_wheel>,
        </flip/Geometry/chassis/fl_arm/fl_steer/fl_wheel/fl_contact>,
        </flip/Geometry/chassis/fl_arm/fl_steer/fl_wheel/fl_hub>,
        </flip/Geometry/chassis/fr_arm>,
        </flip/Geometry/chassis/fr_arm/fr_steer>,
        </flip/Geometry/chassis/fr_arm/fr_steer/fr_wheel>,
        </flip/Geometry/chassis/fr_arm/fr_steer/fr_wheel/fr_contact>,
        </flip/Geometry/chassis/fr_arm/fr_steer/fr_wheel/fr_hub>,
        </flip/Geometry/chassis/nav_mast_pan>,
        </flip/Geometry/chassis/nav_mast_pan/nav_mast_tilt>,
        </flip/Geometry/chassis/rear_cam_pan>,
        </flip/Geometry/chassis/rear_cam_pan/rear_cam_tilt>,
        </flip/Geometry/chassis/rl_arm>,
        </flip/Geometry/chassis/rl_arm/rl_steer>,
        </flip/Geometry/chassis/rl_arm/rl_steer/rl_wheel>,
        </flip/Geometry/chassis/rl_arm/rl_steer/rl_wheel/rl_contact>,
        </flip/Geometry/chassis/rl_arm/rl_steer/rl_wheel/rl_hub>,
        </flip/Geometry/chassis/rr_arm>,
        </flip/Geometry/chassis/rr_arm/rr_steer>,
        </flip/Geometry/chassis/rr_arm/rr_steer/rr_wheel>,
        </flip/Geometry/chassis/rr_arm/rr_steer/rr_wheel/rr_contact>,
        </flip/Geometry/chassis/rr_arm/rr_steer/rr_wheel/rr_hub>,
    ]
    token isaac:robotType = "Wheeled"
    string isaac:source = "lunar-surface-mobility-assets pipeline"
    string isaac:version = "0.1.1"

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "fl_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fl_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fl_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fl_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "fl_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "fr_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fr_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fr_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fr_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "fr_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "nav_mast_pan" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "nav_mast_tilt" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "rear_cam_pan" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rear_cam_tilt" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "rl_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rl_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "rl_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "rl_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "rl_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "rr_arm" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rr_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "rr_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "rr_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "rr_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "head_lamp_l" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "head_lamp_r" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "rear_lamp_l" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "rear_lamp_r" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Floodlight (+Z = beam axis)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "payload_plate" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Payload plate (30 kg)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "lift_point" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Tower lift point"
                uniform token isaac:forwardAxis = "Z"
            }

            over "lidar" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Lidar 3D mapper (estimated position)"
                uniform token isaac:forwardAxis = "Z"
            }

            over "vehicle_origin" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Ground point under the chassis centre at nominal ride height"
                uniform token isaac:forwardAxis = "Z"
            }

            over "imu" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "IMU / navigation reference (estimated)"
                uniform token isaac:forwardAxis = "Z"
            }
        }
    }

    over "Physics"
    {
        over "fl_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fl_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fl_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fr_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fr_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "fr_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "nav_mast_pan" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "nav_mast_tilt" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rear_cam_pan" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rear_cam_tilt" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rl_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rl_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rl_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rr_arm" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rr_steer" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }

        over "rr_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            bool[] isaac:actuator = [1]
        }
    }
}

