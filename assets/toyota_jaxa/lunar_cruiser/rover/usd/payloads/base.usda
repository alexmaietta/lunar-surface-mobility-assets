def Xform "lunar_cruiser" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./lunar_cruiser.usda@
        string name = "lunar_cruiser"
        string version = "0.1.0"
    }
    doc = "JAXA / Toyota Lunar Cruiser pressurised rover, 2025 design (JAXA: 6.44 x 4.84 x 4.85 m, wheelbase 3.81 m, track 3.20 m, 15 t at launch, up to 18 t loaded): a white faceted cab with a two-row bronze windscreen, six brow lamp pods and a LiDAR visor, a grey radiator mid-body with an arched ribbed roof spine, a grey airlock module, grey sponsons over gunmetal skirts with angular wheel arches, and six 1.18 m metal-slat wheels with in-wheel motors on independent double-wishbone suspension (front axle steers). The two stowed solar-wing boxes swing out 90 deg on hinge joints; the Solar=deployed variant raises the 4 x 10 m wings. The rear patio has a hinged walk-in airlock hatch with a hand-wheel latch joint, a grated porch, a fold-down stair joint, handrails, an arched light bar, stowage boxes, gas bottles, a fuel-cell tank row and a stowed robotic arm."
    kind = "component"
)
{
