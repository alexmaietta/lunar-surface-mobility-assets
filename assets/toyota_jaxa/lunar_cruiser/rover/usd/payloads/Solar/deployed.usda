#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "lunar_cruiser"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "lunar_cruiser"
{
    over "Physics"
    {
        over "solar_wing_l"
        {
            float drive:angular:physics:targetPosition = 90
            float state:angular:physics:position = 90
        }

        over "solar_wing_r"
        {
            float drive:angular:physics:targetPosition = 90
            float state:angular:physics:position = 90
        }
    }
}

