#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "lunar_cruiser"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "lunar_cruiser" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "JAXA / Toyota Lunar Cruiser"
    token isaac:license = "Other"
    string isaac:namespace = "lunar_cruiser"
    prepend rel isaac:physics:robotJoints = [
        </lunar_cruiser/Physics/airlock_hatch>,
