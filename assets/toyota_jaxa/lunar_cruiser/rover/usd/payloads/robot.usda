                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Walk-in airlock hatch (1.0 x 1.5 m) outer face; +Z points aft"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "arm_yaw" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "arm_shoulder" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
