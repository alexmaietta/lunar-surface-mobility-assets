    string isaac:source = "lunar-surface-mobility-assets pipeline"
    string isaac:version = "0.1.0"

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "airlock_hatch" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "airlock_handwheel" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "latch_bolt_bottom" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

