#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "lunar_cruiser"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "lunar_cruiser"
{
    over "Physics"
    {
        over "airlock_hatch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "airlock_hatch_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -4000, -400, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 800
            uniform double mjc:forceRange:min = -800
            uniform double[] mjc:gainPrm = [4000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </lunar_cruiser/Physics/airlock_hatch>
        }

        over "airlock_handwheel" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
