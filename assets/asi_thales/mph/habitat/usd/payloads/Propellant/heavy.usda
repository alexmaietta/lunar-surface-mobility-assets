#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mph"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mph"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 2.35)
            float3 physics:diagonalInertia = (18849, 53667.293, 53667.293)
            float physics:mass = 12566
            custom string propellant:source = "Press (Thales programme manager, 2024): around 15 t"
        }
    }
}

