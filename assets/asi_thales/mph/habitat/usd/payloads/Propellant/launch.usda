#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mph"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mph"
{
    over "Geometry"
    {
        over "chassis"
        {
            point3f physics:centerOfMass = (0, 0, 2.35)
            float3 physics:diagonalInertia = (17349, 49396.457, 49396.457)
            float physics:mass = 11566
            custom string propellant:source = "ASI / TAS ICES-2025-60: maximum mass 14,000 kg at launch"
        }
    }
}

