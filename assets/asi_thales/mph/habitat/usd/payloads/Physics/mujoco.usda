#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mph"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "mph"
{
    over "Physics"
    {
        over "bogie_fl" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        over "f0l_wheel" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "f0l_wheel_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -10500, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 2457
            uniform double mjc:forceRange:min = -2457
            uniform double[] mjc:gainPrm = [10500, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </mph/Physics/f0l_wheel>
        }

        over "f1l_steer" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

