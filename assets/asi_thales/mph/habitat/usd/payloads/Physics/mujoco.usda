            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 5250
            uniform double mjc:forceRange:min = -5250
            uniform double[] mjc:gainPrm = [70000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
