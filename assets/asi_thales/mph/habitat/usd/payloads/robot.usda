#usda 1.0
(
    customLayerData = {
        string creator = "lunar-surface-mobility-assets pipeline"
    }
    defaultPrim = "mph"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mph" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "ASI / Thales Alenia Space Multi-Purpose Habitation (MPH)"
    token isaac:license = "Other"
    string isaac:namespace = "mph"
    prepend rel isaac:physics:robotJoints = [
        </mph/Physics/bogie_fl>,
        </mph/Physics/f0l_wheel>,
        </mph/Physics/f1l_steer>,
        </mph/Physics/f1l_wheel>,
        </mph/Physics/bogie_fr>,
        </mph/Physics/f0r_wheel>,
        </mph/Physics/f1r_steer>,
        </mph/Physics/f1r_wheel>,
        </mph/Physics/bogie_rl>,
        </mph/Physics/r0l_steer>,
        </mph/Physics/r0l_wheel>,
        </mph/Physics/r1l_wheel>,
        </mph/Physics/bogie_rr>,
        </mph/Physics/r0r_steer>,
        </mph/Physics/r0r_wheel>,
        </mph/Physics/r1r_wheel>,
        </mph/Physics/dock_door>,
        </mph/Physics/eva_door>,
        </mph/Physics/hga_azimuth>,
        </mph/Physics/hga_elevation>,
        </mph/Physics/porch>,
        </mph/Physics/ladder>,
        </mph/Physics/radiator_wing_l>,
        </mph/Physics/radiator_wing_r>,
        </mph/Physics/solar_yaw>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </mph/Geometry/chassis>,
        </mph/Geometry/chassis/eva_flood_l>,
        </mph/Geometry/chassis/eva_flood_r>,
        </mph/Geometry/chassis/dock_flood_l>,
        </mph/Geometry/chassis/dock_flood_r>,
        </mph/Geometry/chassis/flank_light_l>,
        </mph/Geometry/chassis/flank_light_r>,
        </mph/Geometry/chassis/porch_light>,
        </mph/Geometry/chassis/eva_sill>,
        </mph/Geometry/chassis/docking_port>,
        </mph/Geometry/chassis/berthing_port_l>,
        </mph/Geometry/chassis/berthing_port_r>,
        </mph/Geometry/chassis/power_port>,
        </mph/Geometry/chassis/o2_n2_fill>,
        </mph/Geometry/chassis/lift_point_0>,
        </mph/Geometry/chassis/lift_point_1>,
        </mph/Geometry/chassis/lift_point_2>,
        </mph/Geometry/chassis/lift_point_3>,
        </mph/Geometry/chassis/cabin_centre>,
        </mph/Geometry/chassis/vehicle_origin>,
        </mph/Geometry/chassis/imu>,
        </mph/Geometry/chassis/bogie_fl>,
        </mph/Geometry/chassis/bogie_fl/f0l_wheel>,
        </mph/Geometry/chassis/bogie_fl/f0l_wheel/f0l_contact>,
        </mph/Geometry/chassis/bogie_fl/f0l_wheel/f0l_hub>,
        </mph/Geometry/chassis/bogie_fl/f1l_steer>,
        </mph/Geometry/chassis/bogie_fl/f1l_steer/f1l_wheel>,
        </mph/Geometry/chassis/bogie_fl/f1l_steer/f1l_wheel/f1l_contact>,
        </mph/Geometry/chassis/bogie_fl/f1l_steer/f1l_wheel/f1l_hub>,
        </mph/Geometry/chassis/bogie_fr>,
        </mph/Geometry/chassis/bogie_fr/f0r_wheel>,
        </mph/Geometry/chassis/bogie_fr/f0r_wheel/f0r_contact>,
        </mph/Geometry/chassis/bogie_fr/f0r_wheel/f0r_hub>,
        </mph/Geometry/chassis/bogie_fr/f1r_steer>,
        </mph/Geometry/chassis/bogie_fr/f1r_steer/f1r_wheel>,
        </mph/Geometry/chassis/bogie_fr/f1r_steer/f1r_wheel/f1r_contact>,
        </mph/Geometry/chassis/bogie_fr/f1r_steer/f1r_wheel/f1r_hub>,
        </mph/Geometry/chassis/bogie_rl>,
        </mph/Geometry/chassis/bogie_rl/r0l_steer>,
        </mph/Geometry/chassis/bogie_rl/r0l_steer/r0l_wheel>,
        </mph/Geometry/chassis/bogie_rl/r0l_steer/r0l_wheel/r0l_contact>,
        </mph/Geometry/chassis/bogie_rl/r0l_steer/r0l_wheel/r0l_hub>,
        </mph/Geometry/chassis/bogie_rl/r1l_wheel>,
        </mph/Geometry/chassis/bogie_rl/r1l_wheel/r1l_contact>,
        </mph/Geometry/chassis/bogie_rl/r1l_wheel/r1l_hub>,
        </mph/Geometry/chassis/bogie_rr>,
        </mph/Geometry/chassis/bogie_rr/r0r_steer>,
        </mph/Geometry/chassis/bogie_rr/r0r_steer/r0r_wheel>,
        </mph/Geometry/chassis/bogie_rr/r0r_steer/r0r_wheel/r0r_contact>,
        </mph/Geometry/chassis/bogie_rr/r0r_steer/r0r_wheel/r0r_hub>,
        </mph/Geometry/chassis/bogie_rr/r1r_wheel>,
        </mph/Geometry/chassis/bogie_rr/r1r_wheel/r1r_contact>,
        </mph/Geometry/chassis/bogie_rr/r1r_wheel/r1r_hub>,
        </mph/Geometry/chassis/dock_door>,
        </mph/Geometry/chassis/dock_door/dock_door>,
        </mph/Geometry/chassis/eva_door>,
        </mph/Geometry/chassis/eva_door/eva_door>,
        </mph/Geometry/chassis/hga_azimuth>,
        </mph/Geometry/chassis/hga_azimuth/hga_elevation>,
        </mph/Geometry/chassis/hga_azimuth/hga_elevation/hga_boresight>,
        </mph/Geometry/chassis/porch>,
        </mph/Geometry/chassis/porch/porch_deck>,
        </mph/Geometry/chassis/porch/ladder>,
        </mph/Geometry/chassis/porch/ladder/ladder_foot>,
        </mph/Geometry/chassis/radiator_wing_l>,
        </mph/Geometry/chassis/radiator_wing_r>,
        </mph/Geometry/chassis/solar_yaw>,
        </mph/Geometry/chassis/solar_yaw/blanket_0_normal>,
        </mph/Geometry/chassis/solar_yaw/blanket_1_normal>,
    ]
    token isaac:robotType = "Wheeled"
    string isaac:source = "lunar-surface-mobility-assets pipeline"
    string isaac:version = "0.3.0"

    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "bogie_fl" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "f0l_wheel" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "f0l_contact" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "Nominal tyre contact point"
                        uniform token isaac:forwardAxis = "Z"
                    }

                    over "f0l_hub" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "Wheel centre; +Z = outboard axle"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }

                over "f1l_steer" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "f1l_wheel" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "f1l_contact" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Nominal tyre contact point"
                            uniform token isaac:forwardAxis = "Z"
                        }

                        over "f1l_hub" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                            string isaac:Description = "Wheel centre; +Z = outboard axle"
                            uniform token isaac:forwardAxis = "Z"
                        }
                    }
                }
            }

            over "bogie_fr" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "f0r_wheel" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
