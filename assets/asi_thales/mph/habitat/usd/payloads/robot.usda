                uniform token isaac:forwardAxis = "Z"
            }

            over "docking_port" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Surface docking interface on the docking bulkhead (ring 2.4 m OD) for a shirtsleeve path to the pressurised rover; standard not published"
