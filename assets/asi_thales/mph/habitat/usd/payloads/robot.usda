                    }

                    over "r1r_hub" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "Wheel centre; +Z = outboard axle"
                        uniform token isaac:forwardAxis = "Z"
                    }
                }
            }

            over "dock_door" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "dock_door" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "Docking-end door, doubles as the contingency exit"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "eva_door" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "eva_door" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                    string isaac:Description = "EVA door (1.25 x 1.95 m) into the 14 m3 airlock; +Z points out"
                    uniform token isaac:forwardAxis = "Z"
                }
            }

            over "hga_azimuth" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "hga_elevation" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "hga_boresight" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                        string isaac:Description = "High-gain antenna boresight (+Z), 2-axis gimbal"
