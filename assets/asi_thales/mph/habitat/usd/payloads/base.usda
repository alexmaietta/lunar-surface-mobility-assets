    ]
    upAxis = "Z"
)

def Xform "mph" (
    prepend apiSchemas = ["IsaacRobotAPI", "GeomModelAPI", "SemanticsLabelsAPI:class"]
    assetInfo = {
        asset identifier = @./mph.usda@
        string name = "mph"
        string version = "0.1.1"
    }
    doc = "ASI / Thales Alenia Space Multi-Purpose Habitation module, 2025 reference configuration (ICES-2025-60): the first Artemis surface habitat, a rigid 3 m x 6.55 m horizontal pressure hull (14 m3 airlock + 24 m3 habitat, 8.2 psia) closed by two axial bulkheads behind thick MDPS end rings, on eight 1.44 m all-metal Astrobotic wheels (twin perforated tread bands, tensioned-cable spokes) in two walking-beam bogies per side, with the corner wheels steering. The EVA bulkhead carries a 1.25 x 1.95 m EVA door with a window, a fold-down porch and a ladder; the docking bulkhead carries a second door inside a surface docking ring (shirtsleeve path to the pressurised rover). Two 1.8 x 8 m vertical roll-out solar blankets rise from a sun-tracking roof pedestal (Solar=stowed retracts them for driving), two 3-panel radiator wings hinge from the roof shoulders, battery and power-control boxes ride on the flanks, O2 and N2 tanks under the belly, berthing ports on both flanks, gimballed dishes, lights and handrails. Overall dimensions and the wheel size come from a two-view camera match of the ICES-2025-60 CAD figures scaled to the 3 m hull."
    kind = "component"
)
{
